<?xml version="1.0"?>
<sdf version="1.6">
  <model name="iris_depth_camera_lidar_mine">
    <include><uri>model://iris</uri></include>
    <include><uri>model://depth_camera</uri><pose>0.1 0 0 0 0 0</pose></include>
    <!-- Use zero-range revolute joints, matching the proven mapping-light
         vehicle. Gazebo Classic may lump fixed nested-model joints into the
         canonical link, which changes the PX4 vehicle inertia at startup. -->
    <joint name="depth_camera_joint" type="revolute">
      <parent>iris::base_link</parent><child>depth_camera::link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
    </joint>

    <include><uri>model://mine_depth_camera</uri><pose>0 0 -0.05 0 0 0</pose></include>
    <joint name="mine_camera_joint" type="revolute">
      <parent>iris::base_link</parent><child>mine_depth_camera::link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
    </joint>

    <link name="velodyne_link">
      <pose>0 0 0.06 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia><ixx>0.00008</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.00008</iyy><iyz>0</iyz><izz>0.00008</izz></inertia>
      </inertial>
      <visual name="vlp16_visual">
        <geometry><cylinder><radius>0.025</radius><length>0.030</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
      <sensor name="velodyne_vlp16_mapping" type="ray">
        <visualize>false</visualize><update_rate>3</update_rate>
        <ray>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.523598776</min_angle><max_angle>0.523598776</max_angle></vertical>
          </scan>
          <range><min>0.3</min><max>16.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0</stddev></noise>
        </ray>
        <plugin name="uav0_vlp16_mapping_block_laser" filename="libgazebo_ros_block_laser.so">
          <robotNamespace>/uav0</robotNamespace><alwaysOn>true</alwaysOn><updateRate>3</updateRate>
          <topicName>/uav0/velodyne_points_raw</topicName><frameName>uav0/velodyne_link</frameName><gaussianNoise>0</gaussianNoise>
        </plugin>
      </sensor>
    </link>
    <joint name="velodyne_joint" type="revolute">
      <parent>iris::base_link</parent><child>velodyne_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>0</upper></limit></axis>
    </joint>
  </model>
</sdf>
