# Gazebo model caches
*/.gazebo_cache/

# Hardware-specific TensorRT engines (regenerated per-GPU, not portable)
*.engine

# AWS RoboMaker indoor house world: used only by the legacy indoor demo and is
# large (~131 MB). Kept locally but not shared; clone separately if needed:
#   git clone https://github.com/aws-robotics/aws-robomaker-small-house-world.git
src/aws-robomaker-small-house-world/

# Bulky upstream gazebo_models_worlds_collection: keep ONLY the models our
# worlds actually use; ignore the other ~380 models and the upstream worlds.
src/gazebo_models_worlds_collection/worlds/
src/gazebo_models_worlds_collection/models/*
!src/gazebo_models_worlds_collection/models/cafe_table/
!src/gazebo_models_worlds_collection/models/grass_plane/
