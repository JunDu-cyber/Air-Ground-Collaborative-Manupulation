<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.75 0.78 0.72 1</ambient>
      <background>0.42 0.50 0.44 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Start at (0, -18), yaw +Y. These trees create a real but passable low-altitude corridor. -->
    <include><uri>model://ego_tree</uri><name>tree_left_01</name><pose>-3.2 -14.0 0 0 0 0.0</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_right_01</name><pose>3.0 -13.0 0 0 0 0.4</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_center_01</name><pose>0.0 -9.2 0 0 0 0.9</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_left_02</name><pose>-3.4 -7.2 0 0 0 1.3</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_right_02</name><pose>3.2 -6.0 0 0 0 1.7</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_center_02</name><pose>-0.9 -2.2 0 0 0 2.1</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_left_03</name><pose>-3.3 1.6 0 0 0 2.5</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_right_03</name><pose>3.4 2.4 0 0 0 2.9</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_center_03</name><pose>0.8 6.2 0 0 0 3.3</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_left_04</name><pose>-3.0 9.2 0 0 0 3.7</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_right_04</name><pose>3.1 10.2 0 0 0 4.1</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_left_05</name><pose>-4.4 14.2 0 0 0 4.5</pose></include>
    <include><uri>model://ego_tree</uri><name>tree_right_05</name><pose>4.5 14.8 0 0 0 4.9</pose></include>

    <!-- Extra lidar-visible test obstacles. They have collision geometry, so OctoMap can see them. -->
    <model name="test_stump_01">
      <static>true</static>
      <pose>1.45 -16.2 0 0 0 0.3</pose>
      <link name="link">
        <pose>0 0 0.55 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.24</radius><length>1.10</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.24</radius><length>1.10</length></cylinder></geometry><material><ambient>0.28 0.16 0.08 1</ambient><diffuse>0.36 0.22 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_box_01">
      <static>true</static>
      <pose>-1.9 -12.0 0 0 0 0.8</pose>
      <link name="link">
        <pose>0 0 0.45 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.90 0.65 0.90</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.90 0.65 0.90</size></box></geometry><material><ambient>0.35 0.28 0.16 1</ambient><diffuse>0.48 0.38 0.21 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_pole_01">
      <static>true</static>
      <pose>2.05 -8.4 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 1.10 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>2.20</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>2.20</length></cylinder></geometry><material><ambient>0.24 0.18 0.12 1</ambient><diffuse>0.34 0.25 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_box_02">
      <static>true</static>
      <pose>-2.25 -4.7 0 0 0 -0.5</pose>
      <link name="link">
        <pose>0 0 0.35 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.10 0.55 0.70</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.10 0.55 0.70</size></box></geometry><material><ambient>0.30 0.26 0.22 1</ambient><diffuse>0.42 0.36 0.30 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_stump_02">
      <static>true</static>
      <pose>1.65 -1.1 0 0 0 0.1</pose>
      <link name="link">
        <pose>0 0 0.48 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.30</radius><length>0.96</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.30</radius><length>0.96</length></cylinder></geometry><material><ambient>0.26 0.15 0.08 1</ambient><diffuse>0.37 0.22 0.11 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_pole_02">
      <static>true</static>
      <pose>-1.70 3.6 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 1.20 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.14</radius><length>2.40</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.14</radius><length>2.40</length></cylinder></geometry><material><ambient>0.20 0.18 0.14 1</ambient><diffuse>0.30 0.27 0.20 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_box_03">
      <static>true</static>
      <pose>2.25 5.9 0 0 0 0.35</pose>
      <link name="link">
        <pose>0 0 0.50 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.70 1.00 1.00</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.70 1.00 1.00</size></box></geometry><material><ambient>0.28 0.31 0.24 1</ambient><diffuse>0.39 0.44 0.33 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_stump_03">
      <static>true</static>
      <pose>-1.35 9.8 0 0 0 0.5</pose>
      <link name="link">
        <pose>0 0 0.62 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.26</radius><length>1.24</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.26</radius><length>1.24</length></cylinder></geometry><material><ambient>0.25 0.14 0.07 1</ambient><diffuse>0.36 0.22 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_box_04">
      <static>true</static>
      <pose>1.70 12.8 0 0 0 -0.9</pose>
      <link name="link">
        <pose>0 0 0.40 0 0 0</pose>
        <collision name="collision"><geometry><box><size>1.20 0.60 0.80</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.20 0.60 0.80</size></box></geometry><material><ambient>0.34 0.30 0.25 1</ambient><diffuse>0.47 0.40 0.32 1</diffuse></material></visual>
      </link>
    </model>

    <model name="test_pole_03">
      <static>true</static>
      <pose>-2.15 16.6 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 1.00 0 0 0</pose>
        <collision name="collision"><geometry><cylinder><radius>0.18</radius><length>2.00</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>2.00</length></cylinder></geometry><material><ambient>0.22 0.17 0.12 1</ambient><diffuse>0.32 0.24 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
  </world>
</sdf>
