<launch>
  <!-- ====================================================================
       Air-ground EGOCENTRIC online elevation mapping (ROS layer).

       Assumes Gazebo + PX4 + MAVROS are ALREADY running, the UGV is ALREADY
       spawned + localized (the airground_takeoff.sh script brings the UGV up via
       spawn_outdoor_city.launch DURING the paused window so the -J arm-stow pose
       is held), and BOTH robots are in one world. This file brings up only:

         * UAV ROS layer (TF bridge + LiDAR filtering + EGO) via
           forest_uav_mapping.launch, re-prefixed to uav0/base_link and mounted
           under a spawn-offset uav0/map_local so the UAV cloud lands correctly
           in the shared `map` (and so its base_link does not collide with the
           UGV's base_link).
         * Egocentric elevation_mapping fed by the live UAV LiDAR + real MAVROS
           pose covariance, centered on the UGV's odom.

       Bring up the whole thing with:  bash airground_takeoff.sh
       ==================================================================== -->

  <arg name="rviz" default="true"/>
  <!-- egocentric:=true ties the UAV map to the UGV's DLIO `odom` via a
       capture-once-then-latch anchor (airground_anchor_latch.py) instead of the
       static map->uav0/map_local TF, and expresses the UAV pose covariance in
       odom. Requires the UGV to be running the egocentric nav stack (DLIO ->
       /state_estimation). Default false keeps the legacy GPS-anchored `map`
       behavior. -->
  <arg name="egocentric" default="false"/>

  <!-- Static offset map -> uav0/map_local = where PX4's MAVROS-local origin sits in
       the shared world. X/Y = the UAV spawn XY (MAVROS local xy starts at 0 there).
       Z is NOT the spawn altitude: PX4's local-z origin is the GROUND (the UAV
       settles and EKF2 zeroes z at ground level), which coincides with the UGV
       ground plane (odom z=0). Measured pre-takeoff: Gazebo truth UAV z=0.05 m with
       MAVROS local z=-0.10 m, so MAVROS z=0 <-> ground. A nonzero z here lifts every
       fused cloud point by that amount -> the terrain floats above the UGV. Keep
       z=0 (fine-tune by the few-cm sensor-mount/EKF residual only if needed). -->
  <arg name="uav_spawn_x" default="0.0"/>
  <arg name="uav_spawn_y" default="-18.0"/>
  <arg name="uav_spawn_z" default="0.0"/>

  <arg name="flight_height" default="12.0"/>
  <arg name="low_altitude"  default="false"/>
  <!-- Altitude gate: drop the degenerate on-ground LiDAR scan, fuse only when
       airborne. DEFAULT OFF (enable_gate:=false) — in practice it performs poorly
       (it just hard-drops everything below min_altitude, so it both loses low
       coverage and, if min_altitude sits above the px4_bridge ~2.5 m hover, leaves
       the map empty). With the gate off, elevation_mapping consumes the filtered
       sensor cloud directly. Turn it back on with enable_gate:=true if the
       on-ground ring/bowl artifact reappears. -->
  <arg name="enable_gate" default="false"/>
  <!-- Gate trigger altitude (MAVROS local z), only used when enable_gate:=true.
       Keep BELOW the ~2.5 m takeoff hover or the gate never opens. -->
  <arg name="gate_min_altitude" default="1.5"/>
  <!-- elevation_mapping input: the gated cloud when the gate is on, else the
       filtered sensor cloud straight from the relay. -->
  <arg name="elev_input_topic"
       value="$(eval '/uav0/mapping/velodyne_points_gated' if arg('enable_gate') else '/uav0/mapping/velodyne_points_sensor')"/>

  <!-- NOTE: the UGV (Husky+UR5) is spawned + localized separately by
       airground_takeoff.sh during the Gazebo paused window (so the -J arm-stow
       pose is held). It is NOT spawned here. -->

  <!-- ===== 1. UAV map alignment: shared world map -> UAV MAVROS-local origin ===== -->
  <!-- Legacy: static map->uav0/map_local (GPS-anchored world). -->
  <node unless="$(arg egocentric)"
        pkg="tf2_ros" type="static_transform_publisher" name="tf_map_uav_local"
        args="$(arg uav_spawn_x) $(arg uav_spawn_y) $(arg uav_spawn_z) 0 0 0 map uav0/map_local"/>
  <!-- Egocentric: capture-once-then-latch odom->uav0/map_local from a one-shot
       ground-truth snapshot of the UGV (full pose -> yaw observable), then drop
       GPS/GT and drive on LIO odometry only. -->
  <node if="$(arg egocentric)"
        pkg="mobile_manipulator" type="airground_anchor_latch.py"
        name="airground_anchor_latch" output="screen">
    <param name="odom_frame"      value="odom"/>
    <param name="uav_map_frame"   value="uav0/map_local"/>
    <param name="ugv_truth_topic" value="/ground_truth/state"/>
    <param name="ugv_odom_topic"  value="/state_estimation"/>
    <param name="uav_spawn_x"     value="$(arg uav_spawn_x)"/>
    <param name="uav_spawn_y"     value="$(arg uav_spawn_y)"/>
    <param name="uav_spawn_z"     value="$(arg uav_spawn_z)"/>
    <param name="num_samples"     value="30"/>
  </node>

  <!-- ===== 2. UAV ROS layer (prefixed; no fake UGV marker / RViz / octomap) ===== -->
  <include file="$(find uav_truth_tracker)/launch/forest_uav_mapping.launch">
    <arg name="use_mavros"     value="true"/>
    <arg name="start_rviz"     value="false"/>
    <arg name="enable_octomap" value="false"/>
    <arg name="ugv_urdf"       value=""/>                 <!-- disable the fake UGV marker -->
    <arg name="uav_map_frame"  value="uav0/map_local"/>   <!-- bridge parent -->
    <arg name="uav_body_frame" value="uav0/base_link"/>   <!-- de-collide UAV base_link -->
    <!-- Share the Gazebo sim time base so elevation_mapping can resolve
         odom->uav0/velodyne_link: re-stamp the UAV TF with sim time, and keep the
         velodyne's own sim stamp through the relay (don't overwrite with the
         FCU-clock odom stamp). -->
    <arg name="uav_tf_use_ros_time"   value="true"/>
    <arg name="relay_stamp_with_odom" value="false"/>
    <!-- Re-frame RViz 2D Nav Goals (clicked in the shared world map) into the UAV's
         MAVROS-local frame so the UAV flies to where you clicked, not 18 m off. -->
    <arg name="goal_target_frame" value="uav0/map_local"/>
    <!-- Disable the relay's odom-age drop: MAVROS odom is FCU/wall-clock stamped
         while the cloud is sim-time, so the cross-clock age check would drop EVERY
         frame (map stops updating mid-flight). Velocity-based motion filtering still
         works (it uses twist values, not stamps). -->
    <arg name="relay_max_odom_age" value="0.0"/>
    <arg name="flight_height"  value="$(arg flight_height)"/>
    <arg name="low_altitude"   value="$(arg low_altitude)"/>
  </include>

  <!-- ===== 3. Altitude gate (OPTIONAL, default OFF): drop the on-ground scan ===== -->
  <node if="$(arg enable_gate)"
        pkg="mobile_manipulator" type="uav_cloud_altitude_gate.py"
        name="uav_cloud_altitude_gate" output="screen">
    <param name="min_altitude"  value="$(arg gate_min_altitude)"/>
    <param name="odom_topic"    value="/mavros/local_position/odom"/>
    <param name="clear_service" value="/elevation_mapping/clear_map"/>
    <remap from="~input"  to="/uav0/mapping/velodyne_points_sensor"/>
    <remap from="~output" to="/uav0/mapping/velodyne_points_gated"/>
  </node>

  <!-- ===== 4. Egocentric elevation mapping (live UAV cloud + real MAVROS cov) ===== -->
  <node pkg="elevation_mapping" type="elevation_mapping" name="elevation_mapping" output="screen">
    <rosparam command="load" file="$(find mobile_manipulator)/config/elevation_mapping_uav_live.yaml"/>
    <rosparam command="load" file="$(find mobile_manipulator)/config/elevation_postprocessor.yaml"/>
    <!-- Override the config's input topic: feed the gated cloud only when the gate
         is enabled, otherwise consume the filtered sensor cloud directly. Loaded
         AFTER the rosparam file so it wins over input_sources/uav/topic. -->
    <param name="input_sources/uav/topic" value="$(arg elev_input_topic)"/>
  </node>

  <!-- ===== 5. UAV pose-with-covariance at the UGV centre (real MAVROS cov) ===== -->
  <node pkg="mobile_manipulator" type="uav_pose_cov_publisher.py"
        name="uav_pose_cov_publisher" output="screen">
    <param name="map_frame"   value="odom"/>
    <param name="base_frame"  value="uav0/base_link"/>
    <!-- egocentric: express the UAV pose covariance in odom (no map frame) -->
    <param name="world_frame" value="$(eval 'odom' if arg('egocentric') else 'map')"/>
    <param name="rate"        value="10.0"/>
    <param name="cov_source"  value="mavros_odom"/>
    <param name="odom_topic"  value="/mavros/local_position/odom"/>
  </node>

  <!-- ===== 6. Visualization ===== -->
  <node pkg="grid_map_visualization" type="grid_map_visualization"
        name="elevation_map_visualization" output="screen">
    <param name="grid_map_topic" value="/elevation_mapping/elevation_map_postprocessed"/>
    <rosparam command="load" file="$(find mobile_manipulator)/config/elevation_visualization.yaml"/>
  </node>

  <node if="$(arg rviz)" name="elevation_rviz" pkg="rviz" type="rviz"
        args="-d $(find mobile_manipulator)/rviz/elevation_mapping.rviz"/>
</launch>
