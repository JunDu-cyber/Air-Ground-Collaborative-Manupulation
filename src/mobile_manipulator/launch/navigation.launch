<launch>
  <param name="use_sim_time" value="true"/>

  <!-- ── 1. Load the saved map ── -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(find mobile_manipulator)/maps/small_house_map.yaml"
        output="screen"/>

  <!-- ── 2. AMCL localization ── -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/amcl.yaml"/>
    <remap from="scan" to="/front/scan"/>
  </node>

  <!-- ── 3. move_base ── -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <remap from="cmd_vel" to="cmd_vel"/>

    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/costmap_common.yaml"
              ns="global_costmap"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/costmap_common.yaml"
              ns="local_costmap"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/global_costmap.yaml"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/local_costmap.yaml"/>

    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner"
           value="base_local_planner/TrajectoryPlannerROS"/>

    <param name="TrajectoryPlannerROS/max_vel_x"              value="0.5"/>
    <param name="TrajectoryPlannerROS/min_vel_x"              value="0.1"/>
    <param name="TrajectoryPlannerROS/max_vel_theta"          value="0.8"/>
    <param name="TrajectoryPlannerROS/min_in_place_vel_theta" value="0.4"/>
    <param name="TrajectoryPlannerROS/holonomic_robot"        value="false"/>
    <param name="TrajectoryPlannerROS/xy_goal_tolerance"      value="0.15"/>
    <param name="TrajectoryPlannerROS/yaw_goal_tolerance"     value="0.1"/>

    <param name="recovery_behavior_enabled"        value="true"/>
    <param name="clearing_rotation_allowed"        value="true"/>
    <param name="conservative_reset_dist"          value="3.0"/>
  </node>

  <!-- ── 4. RViz ── -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find mobile_manipulator)/rviz/mapping.rviz"
        output="screen"/>

</launch>