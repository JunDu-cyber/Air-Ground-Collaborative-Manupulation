<launch>
  <param name="use_sim_time" value="true"/>

  <!-- Serialized map saved during mapping via:
       rosservice call /slam_toolbox/serialize_map \
         "filename: '$(find mobile_manipulator)/maps/slam_toolbox_map'"
       This writes slam_toolbox_map.posegraph + slam_toolbox_map.data -->
  <arg name="map" default="$(find mobile_manipulator)/maps/slam_toolbox_map"/>

  <!-- ── 0. Filter robot body self-hits (same as mapping) ── -->
  <node pkg="laser_filters" type="scan_to_scan_filter_chain"
        name="laser_filter" output="screen">
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/laser_filter_arm.yaml"/>
    <remap from="scan"          to="/front/scan"/>
    <remap from="scan_filtered" to="/front/scan_filtered"/>
  </node>

  <!-- ── 1. slam_toolbox in localization mode ── -->
  <node pkg="slam_toolbox" type="localization_slam_toolbox_node"
        name="slam_toolbox" output="screen">
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/slam_toolbox/slam_toolbox_localization.yaml"/>
    <param name="map_file_name"    value="$(arg map)"/>
    <param name="map_start_at_dock" value="true"/>
  </node>

  <!-- ── 2. move_base ── -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <remap from="cmd_vel" to="husky_velocity_controller/cmd_vel"/>

    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/costmap_common.yaml"
              ns="global_costmap"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/costmap_common.yaml"
              ns="local_costmap"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/global_costmap.yaml"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/local_costmap.yaml"/>

    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner"  value="dwa_local_planner/DWAPlannerROS"/>
    <rosparam command="load"
              file="$(find mobile_manipulator)/config/nav/dwa_local_planner.yaml"/>

    <param name="planner_frequency"           value="1.0"/>
    <param name="controller_frequency"        value="10.0"/>
    <param name="recovery_behavior_enabled"   value="true"/>
    <param name="clearing_rotation_allowed"   value="true"/>
    <param name="conservative_reset_dist"     value="3.0"/>
  </node>

  <!-- Initial pose so slam_toolbox localizes without manual RViz interaction -->
  <node pkg="mobile_manipulator" type="publish_initial_pose.py"
        name="initial_pose_publisher" output="screen">
    <param name="x"   value="0.0"/>
    <param name="y"   value="0.0"/>
    <param name="yaw" value="0.0"/>
  </node>

  <node name="visualization_semanticMap" pkg="mobile_manipulator" type="visualize_semantic_map.py"
        output="screen"/>
  <!-- ── 3. RViz ── -->
  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find mobile_manipulator)/rviz/mapping.rviz"
        output="screen"/>
</launch>
