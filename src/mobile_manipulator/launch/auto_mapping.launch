<launch>
  <!-- ── your gmapping node, unchanged ── -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="/front/scan"/>
    <param name="base_frame" value="base_link"/>
    <param name="odom_frame" value="odom"/>
    <param name="map_frame"  value="map"/>
    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="10.0"/>
    <param name="maxRange" value="12.0"/>
    <param name="srr" value="0.1"/>
    <param name="srt" value="0.2"/>
    <param name="str" value="0.1"/>
    <param name="stt" value="0.2"/>
    <param name="xmin" value="-10.0"/>
    <param name="ymin" value="-10.0"/>
    <param name="xmax" value="10.0"/>
    <param name="ymax" value="10.0"/>
    <param name="delta" value="0.05"/>
  </node>

  <!-- ── ADD: move_base (minimal, no yaml needed) ── -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <remap from="cmd_vel" to="husky_velocity_controller/cmd_vel"/>
    <param name="base_global_planner" value="navfn/NavfnROS"/>
    <param name="base_local_planner"  value="base_local_planner/TrajectoryPlannerROS"/>

    <!-- global costmap -->
    <param name="global_costmap/global_frame"      value="map"/>
    <param name="global_costmap/robot_base_frame"  value="base_link"/>
    <param name="global_costmap/update_frequency"  value="2.0"/>
    <param name="global_costmap/static_map"        value="true"/>
    <param name="global_costmap/robot_radius"      value="0.55"/>
    <param name="global_costmap/inflation_radius"  value="0.7"/>

    <!-- global costmap laser source -->
    <param name="global_costmap/obstacle_layer/observation_sources" value="laser"/>
    <param name="global_costmap/obstacle_layer/laser/topic"       value="/front/scan"/>
    <param name="global_costmap/obstacle_layer/laser/data_type"   value="LaserScan"/>
    <param name="global_costmap/obstacle_layer/laser/marking"     value="true"/>
    <param name="global_costmap/obstacle_layer/laser/clearing"    value="true"/>

    <!-- local costmap -->
    <param name="local_costmap/global_frame"      value="odom"/>
    <param name="local_costmap/robot_base_frame"  value="base_link"/>
    <param name="local_costmap/update_frequency"  value="5.0"/>
    <param name="local_costmap/static_map"        value="false"/>
    <param name="local_costmap/rolling_window"    value="true"/>
    <param name="local_costmap/width"             value="4.0"/>
    <param name="local_costmap/height"            value="4.0"/>
    <param name="local_costmap/resolution"        value="0.05"/>
    <param name="local_costmap/robot_radius"      value="0.55"/>
    <param name="local_costmap/inflation_radius"  value="0.7"/>
    <param name="local_costmap/obstacle_layer/observation_sources" value="laser"/>
    <param name="local_costmap/obstacle_layer/laser/topic"       value="/front/scan"/>
    <param name="local_costmap/obstacle_layer/laser/data_type"   value="LaserScan"/>
    <param name="local_costmap/obstacle_layer/laser/marking"     value="true"/>
    <param name="local_costmap/obstacle_layer/laser/clearing"    value="true"/>

    <!-- local planner -->
    <param name="TrajectoryPlannerROS/max_vel_x"               value="0.5"/>
    <param name="TrajectoryPlannerROS/min_vel_x"               value="0.1"/>
    <param name="TrajectoryPlannerROS/max_vel_theta"            value="0.8"/>
    <param name="TrajectoryPlannerROS/min_in_place_vel_theta"   value="0.4"/>
    <param name="TrajectoryPlannerROS/holonomic_robot"          value="false"/>
    <param name="TrajectoryPlannerROS/xy_goal_tolerance"        value="0.15"/>
    <param name="TrajectoryPlannerROS/yaw_goal_tolerance"       value="0.1"/>
  </node>

  <!-- ── ADD: explore_lite for autonomous frontier exploration ── -->
  <node pkg="explore_lite" type="explore" name="explore" output="screen">
    <param name="robot_base_frame"      value="base_link"/>
    <param name="costmap_topic"         value="move_base/global_costmap/costmap"/>
    <param name="costmap_updates_topic" value="move_base/global_costmap/costmap_updates"/>
    <param name="visualize"             value="true"/>
    <param name="planner_frequency"     value="0.33"/>
    <param name="progress_timeout"      value="25.0"/>
    <param name="min_frontier_size"     value="0.5"/>
    <param name="potential_scale"       value="3.0"/>
    <param name="gain_scale"            value="1.0"/>
    <param name="transform_tolerance"   value="0.3"/>
  </node>

  <!-- ── keep or swap: rqt_steering useful as manual override ── -->
  <node pkg="rqt_robot_steering" type="rqt_robot_steering" name="rqt_robot_steering">
    <param name="default_topic" value="husky_velocity_controller/cmd_vel"/>
  </node>

  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find mobile_manipulator)/rviz/mapping.rviz"/>
</launch>