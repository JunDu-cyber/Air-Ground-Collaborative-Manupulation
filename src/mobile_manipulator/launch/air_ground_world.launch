<launch>
  <!-- ======================================================================
       空地协同 — UAV + UGV 同一个 Gazebo 世界（骨架 / Phase 1-2）

       目标分阶段（见 docs，明天从 Phase1+2 啃起）：
         Phase1  一个 gazebo 同时 spawn 两台，物理在跑、不打架   ← 本骨架默认就做这个
         Phase2  解 TF/话题冲突：UAV 用 uav_base_link + /uav/goal，UGV 保留 base_link
         Phase3  两套导航栈并行（start_uav_flight / start_ugv_nav 打开）
         Phase4  在线点云直传（UAV→UGV 代价图实时更新）
         Phase5  任务级协同

       起动顺序（必须先 UGV 后 UAV，PX4 要世界先就绪）：
         gazebo(world) → UGV(spawn+控制器+双EKF) → UAV(px4_spawn_existing)

       用法：
         roslaunch mobile_manipulator air_ground_world.launch                 # 只验证两台共存
         roslaunch mobile_manipulator air_ground_world.launch start_ugv_nav:=true start_uav_flight:=true

       注意：本骨架在 air-ground-merged-world 分支，不动现有两套独立 launch。
       ====================================================================== -->

  <!-- ===== 总参数 ===== -->
  <arg name="gui"   default="true"/>
  <!-- outdoor_city.world 已是 250Hz/step0.004（PX4 锁步兼容）+ 含地形heightmap+楼 -->
  <arg name="world" default="$(find mobile_manipulator)/worlds/outdoor_city.world"/>
  <!-- run_air_ground.sh 默认打开；单独使用本 launch 时可保持原世界不加地雷。 -->
  <arg name="spawn_mines" default="false"/>

  <!-- ★统一坐标系：UAV 从【世界原点(0,0)】起飞 -> 飞控局部系原点=世界原点 -> MAVROS
       /odom == 世界坐标(零偏移)。于是 EGO 轨迹、UAV 模型、点云、地形图、UGV 全在【同一帧】
       重合;之前按出生点参数化的那堆偏移(truth_offset/align_offset/fallback_off)全部自动
       归零、系统更简单。UGV 让到 UAV 原来那片空地(0,-18)。两机相距 18m 不打架。 -->
  <!-- UGV 出生点(挪到 UAV 原空地,让出世界原点给 UAV) -->
  <arg name="ugv_x" default="0.0"/>
  <arg name="ugv_y" default="-18.0"/>
  <arg name="ugv_Y" default="0.0"/>
  <!-- Do not spawn the 2F-140 exactly on its zero-radian hard stop.  With the
       mimic linkage and gravity enabled, the zero target rebounds between
       roughly -0.06 and +0.07 rad while the UGV drives.  This is the same
       verified safe-open value used by mine_grasp_minimal. -->
  <arg name="gripper_initial_position" default="0.08"/>
  <!-- Project-owned URDF post-processing applies physical damping without
       modifying /opt/ros or a generated URDF snapshot.  1.5 N*m*s/rad is the
       value already exercised in the online integrated chain. -->
  <arg name="ur5_joint_damping" default="1.5"/>
  <arg name="ur5_shoulder_lift_damping" default="20.0"/>
  <!-- UAV 出生点 = 世界原点(0,0) -->
  <arg name="uav_x" default="0.0"/>
  <arg name="uav_y" default="0.0"/>
  <arg name="uav_z" default="1.5"/>
  <arg name="uav_Y" default="1.5707963"/>

  <!-- ★Phase2 命名空间隔离的两个关键开关：UAV 独立 base 帧 + 独立目标话题 -->
  <arg name="uav_base_frame" default="uav_base_link"/>   <!-- UGV 仍用 base_link -->
  <arg name="uav_goal_topic" default="/uav/goal"/>       <!-- UGV 仍用 /move_base_simple/goal -->

  <!-- Phase3 开关（骨架默认关，先只验证两台共存） -->
  <arg name="spawn_uav"        default="true"/>   <!-- 是否把 UAV(PX4+iris) 注入世界 -->
  <arg name="start_uav_flight" default="false"/>  <!-- MAVROS + TF桥 + EGO + 建图 -->
  <arg name="start_ugv_nav"    default="false"/>  <!-- move_base + 地形代价图 -->
  <!-- spawn 后是否立刻 unpause 物理。分终端按序启动(run_air_ground.sh)时设 false：
       让 gazebo 保持 paused、UGV 控制器先抓住折叠臂姿态，等 PX4 接上后由脚本统一 unpause，
       避免机械臂在控制器就位前垮下去穿模。单 launch 一把梭(默认 true)则 spawn 即 unpause。 -->
  <arg name="unpause_on_spawn" default="true"/>
  <!-- $(eval) 只能当【整个属性值】用，不能嵌在 args 串里(否则 roslaunch 报 Unknown
       substitution command [eval ...])。所以先把它整体求值成一个 arg，再在 args 里 $(arg). -->
  <arg name="unpause_flag" default="$(eval '-unpause' if unpause_on_spawn else '')"/>

  <env name="HUSKY_LMS1XX_ENABLED" value="1"/>
  <!-- 同时覆盖 UGV + UAV 的模型路径（对齐 one_key_takeoff.sh 里验证可用的那串）：
       $(find mobile_manipulator)/../../models = 仓库根 models（iris_depth_camera / depth_camera 在这里，
       少了它无人机的深度相机就是个白方块）；再加 uav_truth_tracker/models + PX4 sitl 模型。 -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(find mobile_manipulator)/../../models:$(find uav_truth_tracker)/models:$(find gazebo_models_worlds_collection)/models:$(find mobile_manipulator)/gazebo_models:$(find mobile_manipulator)/models:$(env HOME)/PX4-Autopilot/Tools/simulation/gazebo-classic/sitl_gazebo-classic/models:$(env HOME)/.gazebo/gazebo_models:$(env HOME)/.gazebo/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <env name="GAZEBO_RESOURCE_PATH"
       value="$(find mobile_manipulator)/../../worlds:$(find mobile_manipulator)/worlds:$(optenv GAZEBO_RESOURCE_PATH)"/>

  <!-- ============ A) 唯一的一个 Gazebo 世界 ============ -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)"/>
    <arg name="paused"       value="true"/>     <!-- spawn 后 -unpause -->
    <arg name="use_sim_time" value="true"/>
    <arg name="gui"          value="$(arg gui)"/>
  </include>

  <!-- 排雷测试场：地雷模型通过 Gazebo spawn 到 outdoor_city 的起始道路。
       识别节点不使用这里的真值；模型名/位姿只供仿真结果评分。 -->
  <group if="$(arg spawn_mines)">
    <include file="$(find uav_truth_tracker)/launch/spawn_outdoor_mine_field.launch"/>
  </group>
  <!-- TODO(Phase1 调试): 重 world 下 gzserver 可能跑不到 250Hz，PX4 锁步会等超时。
       若 PX4 起不来，参考 one_key_takeoff.sh 里 gazebo 起来后 rosservice call
       /gazebo/set_physics_properties 把 max_update_rate 显式压到 250 的做法。 -->

  <!-- ============ B) UGV：husky_ur5 + 控制器 + 双EKF + twist_mux（沿用 spawn_outdoor_city） ============ -->
  <param name="robot_description"
         command="$(find mobile_manipulator)/scripts/generate_husky_ur5_urdf.py --xacro '$(find mobile_manipulator)/urdf/husky_ur5.urdf.xacro' --arm-joint-damping $(arg ur5_joint_damping) --shoulder-lift-joint-damping $(arg ur5_shoulder_lift_damping)"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
        args="-param robot_description -urdf -model husky_ur5
              -x $(arg ugv_x) -y $(arg ugv_y) -z 0.5 -Y $(arg ugv_Y)
              -J ur5_shoulder_pan_joint 0  -J ur5_shoulder_lift_joint -2.9
              -J ur5_elbow_joint 2.9  -J ur5_wrist_1_joint -1.2
              -J ur5_wrist_2_joint 0.0  -J ur5_wrist_3_joint 0
              -J finger_joint $(arg gripper_initial_position)
              $(arg unpause_flag)"
        output="screen"/>

  <rosparam command="load" file="$(find husky_control)/config/control.yaml"/>
  <rosparam command="load" file="$(find mobile_manipulator)/config/ur5_controllers.yaml"/>
  <!-- 控制器预留 3.5 m/s 给刚性锁定后的平地返程；普通出程仍由 DWA
       配置限制为 2.8 m/s。 -->
  <param name="husky_velocity_controller/linear/x/max_velocity" value="3.5"/>
  <node name="base_controller_spawner" pkg="controller_manager" type="spawner"
        args="husky_joint_publisher husky_velocity_controller" output="screen"/>
  <rosparam param="wheel_radius_multiplier" ns="husky_velocity_controller" subst_value="true">$(optenv HUSKY_WHEEL_MULTIPLIER 1.0)</rosparam>
  <node name="arm_controller_spawner" pkg="controller_manager" type="spawner"
        args="ur5_arm_controller gripper_controller" output="screen"/>

  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization">
    <rosparam command="load" file="$(find husky_control)/config/localization.yaml"/>
    <param name="two_d_mode" value="false"/>
    <!-- 50 Hz repeatedly missed its 20 ms deadline in the CPU-only full stack.
         30 Hz is still 3x the navigation controller rate and reduces TF bursts. -->
    <param name="frequency" value="30.0"/>
  </node>
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_global">
    <rosparam command="load" file="$(find mobile_manipulator)/config/ekf_global.yaml"/>
    <remap from="odometry/filtered" to="odometry/filtered_map"/>
  </node>
  <node pkg="robot_localization" type="navsat_transform_node" name="navsat_transform" output="screen">
    <rosparam command="load" file="$(find mobile_manipulator)/config/navsat_transform.yaml"/>
    <remap from="imu/data"          to="imu/data"/>
    <remap from="gps/fix"           to="navsat/fix"/>
    <remap from="odometry/filtered" to="odometry/filtered_map"/>
  </node>
  <node pkg="twist_mux" type="twist_mux" name="twist_mux">
    <rosparam command="load" file="$(find mobile_manipulator)/config/twist_mux_mine_mission.yaml"/>
    <remap from="cmd_vel_out" to="husky_velocity_controller/cmd_vel"/>
  </node>

  <!-- ============ C) UAV：把 iris + PX4 SITL 注入同一个 gazebo ============ -->
  <group if="$(arg spawn_uav)">
    <include file="$(find uav_truth_tracker)/launch/px4_spawn_existing_gazebo.launch">
      <arg name="x" value="$(arg uav_x)"/>
      <arg name="y" value="$(arg uav_y)"/>
      <arg name="z" value="$(arg uav_z)"/>
      <arg name="Y" value="$(arg uav_Y)"/>
    </include>
  </group>

  <!-- ============ D) UAV 飞行栈（Phase3，默认关）============
       MAVROS + forest_uav_mapping(自带 TF桥 + EGO + 全局规划 + 点云建图)。
       forest_uav_mapping 不自起 gazebo/PX4(本 launch 的 A/C 已起)，可直接 include。
       传 uav_child_frame / uav_goal_topic 做命名空间隔离；flight_height 等显式给(和
       one_key 一致，绕开 forest 里 eval(arg('low_altitude')) 拿不到覆盖值的老坑)。 -->
  <group if="$(arg start_uav_flight)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="udp://:14540@127.0.0.1:14580"/>
    </include>
    <include file="$(find uav_truth_tracker)/launch/forest_uav_mapping.launch">
      <arg name="low_altitude"         value="true"/>
      <arg name="flight_height"        value="4.0"/>
      <arg name="max_vel"              value="0.8"/>   <!-- 1.2->0.8:慢点飞,EGO 轨迹更稳、激光点云不拖影(扫描内运动畸变小) -->
      <arg name="ground_filter_margin" value="0.5"/>
      <arg name="uav_child_frame"      value="$(arg uav_base_frame)"/>  <!-- map→uav_base_link，不撞 UGV -->
      <arg name="uav_goal_topic"       value="$(arg uav_goal_topic)"/>  <!-- /uav/goal，不撞 UGV move_base -->
      <arg name="start_ugv_helper"     value="false"/>                  <!-- 已有真 UGV(B 段)，不起假 UGV 占位 -->
      <arg name="start_rviz"           value="false"/>                  <!-- 合并世界用一个总 RViz -->
    </include>
  </group>

  <!-- ============ E) UGV 导航栈（Phase3，默认关）============ -->
  <group if="$(arg start_ugv_nav)">
    <include file="$(find mobile_manipulator)/launch/ugv_terrain_nav.launch">
      <arg name="localization"   value="false"/>   <!-- 复用本 launch 的双EKF -->
      <arg name="use_sample_map" value="true"/>     <!-- Phase4 改成订阅在线点云 -->
      <arg name="rviz"           value="false"/>    <!-- 合并世界用一个总 RViz -->
      <arg name="ur5_joint_damping" value="$(arg ur5_joint_damping)"/>
      <arg name="ur5_shoulder_lift_damping" value="$(arg ur5_shoulder_lift_damping)"/>
    </include>
  </group>

</launch>
