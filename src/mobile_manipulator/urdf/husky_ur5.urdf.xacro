<?xml version="1.0"?>
<robot name="husky_ur5" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find husky_description)/urdf/husky.urdf.xacro" />

  <xacro:include filename="$(find husky_description)/urdf/accessories/sick_lms1xx_mount.urdf.xacro" />

  <!-- LiDAR lowered from 37.7 cm to 25.7 cm above ground to detect low obstacles.
       tower="0" removes the raised bracket; z=-0.10 drops it 10 cm below top_plate. -->
  <xacro:sick_lms1xx_mount prefix="base"
    parent="top_plate_link"
    topic="/front/scan"
    robot_namespace="/"
    tower="0">
    <origin xyz="0.3 0.0 -0.10" rpy="0.0 0.0 0.0" />
  </xacro:sick_lms1xx_mount>

  <!-- ===== Velodyne VLP-16 3D LiDAR (egocentric LIO + terrain perception) =====
       Mounted on a short mast at the REAR of the top plate (x=-0.30) and raised
       0.40 m. The UR5 base sits at +0.10 and its ~0.85 m reach covers the whole
       plate, so no flat-plate spot is outside the arm's envelope; placing the
       LiDAR behind where the arm actually folds (stow) and reaches (forward
       grasps) keeps the sensor clear of the arm while still giving an elevated
       360° sweep. Child scan frame = "velodyne", cloud topic = /velodyne_points.
       Single exteroceptive sensor for the LIO frontend (DLIO/FAST-LIO) + CMU
       terrain/local planner.
       gpu:=true uses the GPU ray plugin (libgazebo_ros_velodyne_gpu_laser): the
       CPU multiray sensor produces no cloud for a 16-layer Velodyne under
       gzserver. A GPU + GL context (DISPLAY) is required; this machine has both.
       The arm may still clip the FoV — robot_body_filter removes it downstream. -->
  <!-- thin support mast: top_plate -> 0.40 m up at x=-0.30 (behind the arm) -->
  <link name="velodyne_mast_link">
    <visual>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.40"/></geometry>
      <material name="mast_grey"><color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.40"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <origin xyz="0 0 0.20" rpy="0 0 0"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="velodyne_mast_joint" type="fixed">
    <parent link="top_plate_link"/>
    <child link="velodyne_mast_link"/>
    <!-- x=-0.50 on the plate (base_link x~-0.42): behind the stow forearm fold
         (which reaches back to base_link x~-0.23) yet still over the chassis
         (rear edge ~-0.49). -->
    <origin xyz="-0.50 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/>
  <xacro:VLP-16 parent="velodyne_mast_link" name="velodyne" topic="/velodyne_points"
                hz="10" samples="1875" gpu="true"
                min_range="0.5" max_range="100.0">
    <origin xyz="0.0 0.0 0.40" rpy="0.0 0.0 0.0"/>
  </xacro:VLP-16>

  <!-- ===== Dedicated IMU for LiDAR-inertial odometry (gravity-included) =====
       DLIO/FAST-LIO require the accelerometer to report the gravity reaction
       (~9.8 m/s² at rest) to estimate orientation + the gravity vector. The
       stock Husky IMU (libhector_gazebo_ros_imu, topic /imu/data) outputs
       kinematic acceleration WITHOUT gravity, so LIO init fails. The Gazebo
       sensor-based libgazebo_ros_imu_sensor reads the true simulated IMU
       (gravity included). Mounted axis-aligned at the base_link origin so the
       base_link->imu extrinsic is identity. Topic: /lidar/imu. -->
  <link name="imu_lidar_link">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_lidar_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="imu_lidar_link">
    <sensor name="imu_lidar_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>false</visualize>
      <plugin name="imu_lidar_plugin" filename="libgazebo_ros_imu_sensor.so">
        <topicName>/lidar/imu</topicName>
        <bodyName>imu_lidar_link</bodyName>
        <frameName>imu_lidar_link</frameName>
        <updateRateHZ>200.0</updateRateHZ>
        <gaussianNoise>0.0</gaussianNoise>
        <initialOrientationAsReference>false</initialOrientationAsReference>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:include filename="$(find ur_description)/urdf/inc/ur_macro.xacro"/>

  <xacro:ur_robot
    prefix="ur5_"
    transmission_hw_interface="hardware_interface/PositionJointInterface"
    joint_limits_parameters_file="$(find ur_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/ur5/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5/visual_parameters.yaml" />

  <joint name="husky_to_ur5_joint" type="fixed">
    <parent link="top_plate_link" />
    <child link="ur5_base_link" />
    <origin xyz="0.1 0.0 0.0" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- Virtual ballast: simulates the Husky's rear battery bank.
       The stock inertial_link iyy (1.74 kg⋅m²) is less than half the
       theoretical value for the chassis dimensions, leaving the base on the
       edge of tipping when the arm is extended.  The mass is placed behind and
       BELOW base_link to shift the CoM rearward and DOWN.
       上坡稳定性加强：UR5 装在顶板上抬高了整车质心，在斜坡上(尤其转弯/进坡)容易
       翻车。把压舱质量从 30→45 kg、并从 -0.08 下沉到 -0.20 m(到接触面附近)，显著
       压低质心 -> 抗倾覆角变大、坡上不易翻。配合 slope_max 限到 ~22° 不去爬超过
       翻车角的坡，以及 DWA 减速/缓转。 -->
  <link name="base_ballast">
    <inertial>
      <mass value="45.0" />
      <origin xyz="-0.15 0.0 -0.20" rpy="0 0 0" />
      <inertia ixx="2.5" ixy="0" ixz="0"
               iyy="4.0" iyz="0" izz="4.0" />
    </inertial>
  </link>
  <joint name="base_ballast_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_ballast" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- Gripper -->

  <!-- Robotiq 2F-140 parallel-jaw gripper: 140 mm max stroke (~3x the Hand-E's
       50 mm), enabling grasps of larger outdoor objects. Single actuated joint
       finger_joint (revolute, 0 rad = open, 0.7 rad = closed); all other finger
       joints mimic it via the gazebo_mimic_joint plugins defined in the macro. -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_140_gripper.urdf.xacro" />
  <xacro:robotiq_140_gripper prefix="" parent="ur5_tool0" >
    <origin xyz="0 0 0" rpy="0 -1.57 1.57"/>
  </xacro:robotiq_140_gripper>

  <!-- ===== grasp_tcp: THE grasp frame. Every grasp pose is a pose of this link. =====
       Parented to the gripper (not ur5_tool0) so it is a property of the hand and
       survives a remount. Its numbers are FK, not guesses: the jaw center-line is by
       definition the midpoint of the two inner_finger_pads, and that midpoint lies
       exactly on robotiq_arg2f_base_link's +Z at x=y=0 —

           finger_joint = 0.000 (open)   -> midpoint z = 0.1770, gap 136.0 mm
           finger_joint = 0.350          -> midpoint z = 0.1945, gap  75.9 mm
           finger_joint = 0.695 (closed) -> midpoint z = 0.2007, gap   8.3 mm

       z = 0.177 = the OPEN jaw center, i.e. where the object sits at the instant the
       gripper ARRIVES at the grasp (we always approach open). Note the pads then
       ADVANCE ~21 mm further along +Z as they close — that is the 2F-140's four-bar
       linkage arc, not an error — so a grasp aimed exactly at an object's center will
       have the pads settle ~21 mm beyond it. Grasp code compensates by aiming high;
       for the 60 mm landmine detonator that is comfortably inside the block.

       AXES (the one convention, defined once, used everywhere):
           +Z = approach        (out of the palm, between the fingers)
           +X = finger closing  (== GPD's `binormal`)
           +Y = GPD's `axis`
       The gripper base's own axes are +Z approach / +-Y closing, so this is a pure
       +90 deg yaw: Rz(pi/2) sends tcp_X -> base_Y (closing) and leaves tcp_Z = base_Z.

       This link replaces the legacy scalars GPD_TOOL_OFFSET=0.12 and FINGER_REACH=0.18,
       which tried to fake a grasp frame by sliding ur5_tool0 along tool0's OWN +Z — but
       the gripper is mounted rpy="0 -1.57 1.57", so tool0's Z is not the approach axis
       at all. Set MoveIt/MTC ik_frame to grasp_tcp and the offsets vanish.

       Massless and geometry-less: Gazebo lumps it away, so it adds no physics and needs
       no SRDF collision entry. -->
  <link name="grasp_tcp"/>
  <joint name="grasp_tcp_joint" type="fixed">
    <parent link="robotiq_arg2f_base_link"/>
    <child  link="grasp_tcp"/>
    <origin xyz="0 0 0.177" rpy="0 0 ${pi/2}"/>
  </joint>

  <!-- gazebo_grasp_fix IS DELIBERATELY NOT LOADED. It cannot work on this gripper, and
       leaving it running would fight the weld that does.

       It attaches an object only when it sees TWO OPPOSING CONTACT FORCES on the finger links.
       But the 2F-140's mimic joints are all driven by robotiq_gazebo's MimicJointPlugin via
       SetPosition(), a kinematic teleport, and right_outer_knuckle_joint is itself a mimic,
       so the ENTIRE right finger is kinematic: forced to its commanded angle regardless of what
       it touches, exerting no force on anything. There are no opposing grip forces here for
       grasp_fix to find, so it fires on solver noise instead. Measured across 7 trials, its
       "attach" landed at finger_joint = 0.4254, 0.4387, 0.4413, 0.480, 0.495 and even 0.0017
       (jaws WIDE OPEN) for one and the same 40 mm block, whose true contact angle is 0.495.
       Raising grip_count_threshold to reject that noise stopped it firing at the real contact
       too. Its hold is broken independently: it welds with a MODEL-LESS ZERO-LIMIT REVOLUTE,
       which on Gazebo 11 is a free hinge. During a lift the TCP rose 120 mm while the mine
       rose 16 mm, and the constraint reaction jacked the 46 kg base into the air.

       The grasp is therefore an EXPLICIT WELD (gazebo_link_attacher, registered in
       outdoor_city.world): the jaws close to a gap slightly WIDER than the block so they never
       touch it, and a real fixed joint carries it. See grasp_mtc/scripts/grasp_task.py. -->

  <link name="realsense_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.02 0.05 0.02"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1" /> <origin xyz="0 0 0" rpy="0 0 0" />
      <inertia ixx="0.00002" ixy="0.0" ixz="0.0"
               iyy="0.00001" iyz="0.0"
               izz="0.00002" />
    </inertial>
  </link>

  <joint name="camera_to_wrist" type="fixed">
    <parent link="ur5_tool0" />
    <child link="realsense_camera_link" />
    <origin xyz="0.0 0.05 0.0" rpy="0.0 -1.57 -1.57" />
  </joint>

  <!--
    Optical-frame "dummy" link (no mass / visual / collision — intentional).
    REP-103 convention: Z forward (into scene), X right, Y down.
    rpy="-π/2 0 -π/2" rotates the camera body frame (Z forward, Y up) to the
    optical frame (Z forward, Y down). This must match the convention assumed by
    the pinhole back-projection in get_3d_coordinates and by libgazebo_ros_openni_kinect
    (frameName = realsense_camera_optical_frame).  Do NOT change this transform
    without updating the back-projection formula.
  -->
  <link name="realsense_camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="realsense_camera_link" />
    <child link="realsense_camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>

  <gazebo reference="realsense_camera_link">
    <sensor type="depth" name="realsense_depth">
      <update_rate>30.0</update_rate>
      <visualize>true</visualize>
      <camera>
        <horizontal_fov>1.047198</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>3.0</far>
        </clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_openni_kinect.so">
        <baseline>0.2</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>camera_ir</cameraName>
        <imageTopicName>/camera/color/image_raw</imageTopicName>
        <cameraInfoTopicName>/camera/color/camera_info</cameraInfoTopicName>
        <depthImageTopicName>/camera/depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>/camera/depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>/camera/depth/points</pointCloudTopicName>
        <frameName>realsense_camera_optical_frame</frameName>
        <pointCloudCutoff>0.05</pointCloudCutoff>
        <pointCloudCutoffMax>3.0</pointCloudCutoffMax>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== 地面真值位姿(含真实高度 z)：让 UGV 在 RViz 里跟着地形爬高 =====
       2D 模式的 EKF 把机器人 z 锁成 0，在真实高程的坡上 UGV 就被埋到坡面下。
       这个 p3d 插件直接从 Gazebo 取 base_link 的真值位姿(含 z/俯仰)，发到
       /ground_truth/state，由 global EKF 只融合其中的 z(见 ekf_global.yaml)。
       frameName=map：本工程 map 原点 == Gazebo 世界原点(GPS 锚定)，故真值世界 z
       即 map 系 z。只喂 z、不动 x/y(仍由轮速+GPS主导)，对 2D 导航几乎无影响。 -->
  <gazebo>
    <plugin name="ground_truth_p3d" filename="libgazebo_ros_p3d.so">
      <bodyName>base_link</bodyName>
      <topicName>/ground_truth/state</topicName>
      <frameName>map</frameName>
      <updateRate>50.0</updateRate>
      <gaussianNoise>0.0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rpyOffset>0 0 0</rpyOffset>
    </plugin>
  </gazebo>

  <!-- ===== 上坡力度：加大 4 个驱动轮的接触摩擦 =====
       stock husky_description/wheel.urdf.xacro 设 mu1=mu2=1.0，仿真里在坡面上
       轮子打滑 -> 上不去/往下滑（轮关节是 continuous 且无 effort 限制，所以瓶颈
       是【摩擦】不是扭矩）。这里按轮 link 名再写一遍 <gazebo reference> 覆盖，
       SDF 取后出现的值 -> mu 提到 4.0，沿滚动方向(fdir1=x)抓地更牢，上坡少打滑；
       kd 1->10 增大接触阻尼，减小轮子在坡上弹跳/打颤丢失接触。配合压低质心(压舱+收臂)
       和缓加速(DWA acc_lim_x) 一起：上坡靠抓地+不猛冲轮子来防打滑下滑。 -->
  <xacro:macro name="wheel_friction" params="link">
    <gazebo reference="${link}">
      <mu1 value="4.0"/>
      <mu2 value="4.0"/>
      <kp value="10000000.0"/>
      <kd value="10.0"/>
      <fdir1 value="1 0 0"/>
      <minDepth>0.005</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_friction link="front_left_wheel_link"/>
  <xacro:wheel_friction link="front_right_wheel_link"/>
  <xacro:wheel_friction link="rear_left_wheel_link"/>
  <xacro:wheel_friction link="rear_right_wheel_link"/>

</robot>
