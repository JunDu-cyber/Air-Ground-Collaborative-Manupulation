<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="outdoor">
    <!-- Place user camera -->
    <gui>
      <camera name="user_camera">
        <pose>-11.660200 -5.942800 6.053900 0.000000 0.443643 0.352194</pose>
      </camera>
    </gui>
    <scene>
      <ambient>0.2 0.2 0.2 1.0</ambient>
      <grid>false</grid>
      <sky>
        <clouds>
          <speed>4</speed>
        </clouds>
      </sky>
    </scene>

    <!-- Only one ROS interface plugin is required per world, as any other plugin can connect a Gazebo
         topic to a ROS topic (or vise versa). -->
    <!-- <plugin name="ros_interface_plugin" filename="librotors_gazebo_ros_interface_plugin.so"/>-->

    <!-- Welds a grasped object to the gripper on request (/link_attacher/attach|detach).
         Inert until called, so this changes nothing for the nav/UAV missions.

         It exists because the 2F-140 CANNOT GRIP in this sim: MimicJointPlugin drives every
         mimic joint with SetPosition() (a kinematic teleport) and right_outer_knuckle_joint
         is itself a mimic, so the whole right finger is kinematic and exerts no force on what
         it touches. That is why gazebo_grasp_fix -- which welds only on OPPOSING CONTACT
         FORCES -- never fired, and why closing on the detonator either missed it or
         penetrated it, throwing the robot. See gazebo_link_attacher/src for the full story. -->
    <plugin name="link_attacher" filename="libgazebo_link_attacher.so"/>

    <physics type='ode'>
      <ode>
        <solver>
          <type>quick</type>
          <iters>1000</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <!-- 1.0, not the stock 100. This caps how fast ODE may push two interpenetrating
               bodies apart. At 100 it is licensed to resolve a penetration at up to 100 m/s,
               so the instant the gripper closes on the detonator the solver answers with an
               impulse that shakes the arm, flings the mine, and has repeatedly TIPPED THE
               46 kg HUSKY OVER. Nothing in this mission legitimately needs to separate at
               more than 1 m/s, so this is the single most important physics setting here:
               it is the difference between a grasp and an explosion.
               Driving is unaffected; the wheels never penetrate deeply enough to care. -->
          <!-- 1.0, not the stock 100, and NOT 10. This caps how fast ODE may push two
               interpenetrating bodies apart, and it is the single most important physics
               setting here.

               At the stock 100 it is licensed to resolve a penetration at up to 100 m/s: the
               moment the jaws bite, the solver answers with an impulse that shakes the arm and
               has repeatedly thrown the 46 kg Husky metres and spun finger_joint through 2*pi.

               10 is not safe either. Measured with a streaming log: while the arm sat STILL and
               the jaws closed, the base was jacked from z=0.132 up to z=0.227 and hurled away.
               At 1.0 the base holds to within 7 mm through the same close.

               The reason we can afford 1.0 is that the task now PLACES the mine back on the
               ground before opening the jaws instead of dropping it from 0.4 m. A dropped rigid
               body penetrates deeply and, at 1.0, is pushed back out too slowly, so it sinks
               through the floor. No drop, no need for a fast correction.

               Driving is unaffected; the wheels never penetrate deeply enough to care. -->
          <contact_max_correcting_vel>1.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <!-- PX4 lockstep (gazebo_mavlink_interface) requires real_time_update_rate
           to be a multiple of 250 Hz, else gzserver aborts on load.
           250 Hz * 0.004 s = 1.0 real-time factor. -->
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>
    <!-- Light Source -->
