Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Value: true
      Visual Enabled: true
    - Class: rviz/TF
      Enabled: false
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: slope
      Color Transformer: GridMapLayer
      ColorMap: default
      Enabled: true
      Grid Cell Decimation: 1
      Grid Line Thickness: 0.1
      Height Layer: elevation_inpainted
      Height Transformer: GridMapLayer
      History Length: 1
      Invert ColorMap: false
      Max Color: 255; 255; 255
      Max Intensity: 10
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Elevation Map (height=elev, color=slope)
      Show Grid Lines: false
      Topic: /elevation_mapping/elevation_map_postprocessed
      Unreliable: false
      Use ColorMap: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: grid_map_rviz_plugin/GridMap
      Color: 200; 200; 200
      Color Layer: elevation
      Color Transformer: GridMapLayer
      ColorMap: default
      Enabled: true
      Grid Cell Decimation: 1
      Grid Line Thickness: 0.1
      Height Layer: elevation
      Height Transformer: GridMapLayer
      History Length: 1
      Invert ColorMap: false
      Max Color: 255; 255; 255
      Max Intensity: 10
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: Fused Elevation Map (raw, observed only)
      Show Grid Lines: false
      Topic: /elevation_mapping/elevation_map
      Unreliable: false
      Use ColorMap: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: Elevation Cloud
      Size (m): 0.05
      Style: Boxes
      Topic: /elevation_mapping/elevation_cloud
      Use Fixed Frame: true
      Value: false
    - Alpha: 0.5
      Autocompute Intensity Bounds: true
      Class: rviz/PointCloud2
      Color: 0; 255; 0
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: UAV LiDAR Cloud (filtered, PointCloud2)
      Size (m): 0.1
      Style: Points
      Topic: /uav0/mapping/velodyne_points_sensor
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 60
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.7
      Target Frame: base_link
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Width: 1200
