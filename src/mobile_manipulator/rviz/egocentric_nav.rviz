Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /FAR cost (/terrain_map_ext)1
        - /FAR global path (/viz_path_topic)1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz/Tool Properties
    Expanded:
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.6
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid (odom)
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
      Value: true

    - Alpha: 1
      Class: rviz/RobotModel
      Enabled: true
      Name: Robot
      Robot Description: robot_description
      TF Prefix: ""
      Value: true
      Visual Enabled: true

    - Class: rviz/TF
      Enabled: false
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: false

    # --- THE headline display: FAR's traversal cost. intensity 0 (blue) = free,
    #     up to vehicle_height (red) = impassable. Should hug the observed area,
    #     be blue on roads/grass and red on buildings. This is the cloud FAR plans on.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 1.0
      Min Color: 0; 0; 0
      Min Intensity: 0.0
      Name: FAR cost (/terrain_map_ext)
      Position Transformer: XYZ
      Size (Pixels): 3
      Size (m): 0.22
      # Flat Squares (2 triangles/point), NOT Boxes (12): the map is ~25k points, and
      # RViz's OGRE 1.9 renderer intermittently segfaults inside the NVIDIA GL driver.
      # Less geometry through that path = less exposure, and it keeps software_gl:=true
      # (llvmpipe) fast enough to be usable. A 2.5D cost map reads fine flat anyway.
      Style: Flat Squares
      Topic: /terrain_map_ext
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # --- THE obstacle map localPlanner gates on: the plane-fit cost,
    #     max(|step|, 0.15 * slope/0.44). Intensity range is 0..0.3 so the 0.15 obstacle
    #     gate sits in the MIDDLE of the rainbow: blue/cyan = free, green ~ on the gate,
    #     orange/red = obstacle. A smooth slope up to 25 deg stays blue; a wall, curb or
    #     ditch goes red. This is the display that shows the fix.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Max Intensity: 0.3
      Min Intensity: 0.0
      Name: Obstacle cost (/terrain_map) gate=0.15
      Position Transformer: XYZ
      Size (m): 0.22
      Style: Flat Squares
      Topic: /terrain_map
      Use rainbow: true
      Value: true

    # --- STEP: the signed residual from the locally fitted plane. THIS is the new
    #     metric itself. Flat ground and smooth slopes alike read ~0 (that is the whole
    #     point); walls and curbs go positive, ditches negative. Surface height is the
    #     elevation, colour is the step.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: step
      Color Transformer: GridMapLayer
      ColorMap: default
      Enabled: false
      Grid Cell Decimation: 1
      Grid Line Thickness: 0.1
      Height Layer: elevation_filled
      Height Transformer: GridMapLayer
      History Length: 1
      Invert ColorMap: false
      Max Intensity: 0.3
      Min Intensity: -0.3
      Name: grid_map STEP (residual from local plane)
      Show Grid Lines: false
      Topic: /elevation_mapping/elevation_map_postprocessed
      Use ColorMap: true
      Value: false

    # --- SLOPE (rad). 0.44 rad = 25 deg = the Husky limit, so the top of the colour
    #     range IS the limit: anything short of full-scale is climbable.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: slope
      Color Transformer: GridMapLayer
      ColorMap: default
      Enabled: false
      Grid Cell Decimation: 1
      Grid Line Thickness: 0.1
      Height Layer: elevation_filled
      Height Transformer: GridMapLayer
      History Length: 1
      Invert ColorMap: false
      Max Intensity: 0.44
      Min Intensity: 0.0
      Name: grid_map SLOPE (full scale = 25 deg limit)
      Show Grid Lines: false
      Topic: /elevation_mapping/elevation_map_postprocessed
      Use ColorMap: true
      Value: false

    # --- TRAVERSABILITY 0..1 (1 = perfect ground). This is what FAR plans on.
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Class: grid_map_rviz_plugin/GridMap
      Color Layer: traversability
      Color Transformer: GridMapLayer
      ColorMap: default
      Enabled: false
      Grid Cell Decimation: 1
      Grid Line Thickness: 0.1
      Height Layer: elevation_filled
      Height Transformer: GridMapLayer
      History Length: 1
      Invert ColorMap: false
      Max Intensity: 1.0
      Min Intensity: 0.0
      Name: grid_map TRAVERSABILITY
      Show Grid Lines: false
      Topic: /elevation_mapping/elevation_map_postprocessed
      Use ColorMap: true
      Value: false

    # --- Live LiDAR after self-filtering + registration, colored by height.
    - Alpha: 0.6
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Enabled: true
      Name: LiDAR (/registered_scan)
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic: /registered_scan
      Use Fixed Frame: true
      Value: true

    # --- FAR visibility graph: the nodes + edges FAR routes over. Should be a
    #     sparse polyline skeleton, NOT a dense speckle (dense = phantom obstacles).
    - Class: rviz/MarkerArray
      Enabled: true
      Name: FAR visibility graph (/viz_graph_topic)
      Marker Topic: /viz_graph_topic
      Namespaces: {}
      Queue Size: 100
      Value: true

    # --- FAR obstacle contours (the polygon boundaries it extracts).
    - Class: rviz/MarkerArray
      Enabled: true
      Name: FAR contours (/viz_contour_topic)
      Marker Topic: /viz_contour_topic
      Namespaces: {}
      Queue Size: 100
      Value: true

    # --- FAR global route to the goal (green polyline). This is the plan.
    - Class: rviz/Marker
      Enabled: true
      Name: FAR global path (/viz_path_topic)
      Marker Topic: /viz_path_topic
      Namespaces: {}
      Queue Size: 100
      Value: true

    # --- FAR graph nodes.
    - Class: rviz/Marker
      Enabled: true
      Name: FAR nodes (/viz_node_topic)
      Marker Topic: /viz_node_topic
      Namespaces: {}
      Queue Size: 100
      Value: true

    # --- The immediate waypoint FAR hands to the local planner (steps toward goal).
    - Alpha: 1
      Class: rviz/PointStamped
      Color: 255; 170; 0
      Enabled: true
      History Length: 1
      Name: FAR waypoint (/way_point)
      Radius: 0.4
      Topic: /way_point
      Value: true

    # --- Your commanded goal (what you clicked). See Tools note below.
    - Alpha: 1
      Class: rviz/PointStamped
      Color: 255; 0; 0
      Enabled: true
      History Length: 1
      Name: Goal (/goal_point)
      Radius: 0.5
      Topic: /goal_point
      Value: true

    # --- What FAR itself classified as obstacle (red) vs free (green) after its
    #     z-crop. If obstacles look empty here while buildings are visible, the
    #     terrain cloud is being cropped away. Off by default.
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 0; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: FAR obstacles (/FAR_obs_debug)
      Position Transformer: XYZ
      Size (m): 0.15
      Style: Boxes
      Topic: /FAR_obs_debug
      Use Fixed Frame: true
      Value: false

    - Alpha: 0.3
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 0; 255; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Name: FAR free (/FAR_free_debug)
      Position Transformer: XYZ
      Size (m): 0.1
      Style: Points
      Topic: /FAR_free_debug
      Use Fixed Frame: true
      Value: false

  Enabled: true
  Global Options:
    Background Color: 32; 32; 32
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    # ---- "2D Nav Goal" -> /ugv/goal : works in EITHER planner mode ----
    # /ugv/goal (PoseStamped) is the goal seam both modes listen on:
    #   global_planner:=none -> goal_to_waypoint.py     /ugv/goal -> /way_point  -> localPlanner
    #   global_planner:=far  -> ugv_goal_to_far_goal.py /ugv/goal -> /goal_point -> FAR
    # It has to be SetGoal rather than PublishPoint, because the seam is a PoseStamped and
    # PublishPoint can only emit a PointStamped. Use this one with global_planner:=none,
    # which drives localPlanner directly and does not depend on FAR being initialised.
    - Class: rviz/SetGoal
      Topic: /ugv/goal

    # ---- "Publish Point" -> /goal_point : straight to FAR ----
    # This is the CORRECT topic for FAR and it does work: FAR subscribes to /goal_point
    # (far_planner.cpp:19) and drives to it.
    #
    # But FAR will ignore it until its visibility graph exists. WaypointCallBack
    # (far_planner.cpp:699) returns early on !is_graph_init_ and only warns in DEBUG
    # mode, so an early click vanishes with no message at all. The graph only comes up
    # once FAR has an obstacle to plan around (is_cloud_init_ needs a non-empty
    # surround_obs_cloud_).
    #
    # Watch out for test_ramp:=true here: with the ramp in front of the robot,
    # /FAR_obs_debug measures width=0 and no graph is ever built, so every click is
    # silently dropped -- even though /terrain_map_ext plainly carries 353 obstacle cells
    # (315 of them surviving FAR's z-crop). Without the ramp FAR builds a 139-vertex graph
    # and Publish Point drives normally. So: ramp OR FAR, not both.
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /goal_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 45
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Orbit (follows robot)
      Pitch: 1.0
      Target Frame: base_link
      Yaw: 3.1
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
  Hide Left Dock: false
  Hide Right Dock: true
