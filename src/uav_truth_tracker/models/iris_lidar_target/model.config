<?xml version="1.0"?>
<model>
  <name>iris_lidar_target</name>
  <version>1.0</version>
  <sdf version="1.5">model.sdf</sdf>
  <author>
    <name>uav_truth_tracker</name>
    <email>noreply@example.com</email>
