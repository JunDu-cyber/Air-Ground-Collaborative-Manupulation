<launch>
  <arg name="dataset_dir" default="$(env HOME)/uav_yolo_dataset"/>
  <arg name="max_images" default="3000"/>
  <arg name="max_new_images" default="0"/>
  <arg name="sample_rate" default="5.0"/>
  <arg name="negative_sample_ratio" default="0.25"/>
  <arg name="dataset_tag" default="default"/>

  <node pkg="uav_truth_tracker" type="collect_uav_yolo_dataset_node.py"
        name="collect_uav_yolo_dataset_node" output="screen">
    <param name="rgb_topic" value="/iris0/camera/rgb/image_raw"/>
    <param name="depth_topic" value="/iris0/camera/depth/image_raw"/>
    <param name="camera_info_topic" value="/iris0/camera/rgb/camera_info"/>
    <param name="uav1_odom_topic" value="/uav1/mavros/local_position/odom"/>
    <param name="fixed_frame" value="map"/>
    <param name="dataset_dir" value="$(arg dataset_dir)"/>
    <param name="max_images" value="$(arg max_images)"/>
    <param name="max_new_images" value="$(arg max_new_images)"/>
    <param name="sample_rate" value="$(arg sample_rate)"/>
    <param name="negative_sample_ratio" value="$(arg negative_sample_ratio)"/>
    <param name="dataset_tag" value="$(arg dataset_tag)"/>
    <param name="uav1_spawn_x" value="2.0"/>
    <param name="uav1_spawn_y" value="0.0"/>
    <param name="uav1_spawn_z" value="0.0"/>
    <param name="target_size_x" value="1.0"/>
    <param name="target_size_y" value="1.0"/>
    <param name="target_size_z" value="0.35"/>
    <param name="depth_visibility_check" value="true"/>
  </node>
</launch>
