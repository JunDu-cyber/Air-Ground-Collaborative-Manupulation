<launch>
  <arg name="frame_id" default="map"/>

  <arg name="target_mode" default="circle_z_sine"/>
  <arg name="target_height" default="3.0"/>
  <arg name="target_radius" default="3.0"/>
  <arg name="uav1_speed" default="1.2"/>
  <arg name="target_center_x" default="2.0"/>
  <arg name="target_center_y" default="0.0"/>
  <arg name="target_direction" default="1.0"/>
  <arg name="z_amplitude" default="0.5"/>
  <arg name="z_period" default="12.0"/>
  <arg name="uav1_motion_start_delay" default="0.0"/>

  <arg name="depth_points_topic" default="/iris0/camera/depth/points"/>
  <arg name="depth_image_topic" default="/iris0/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/iris0/camera/depth/camera_info"/>
  <arg name="start_depth_detector" default="true"/>
  <arg name="visual_pose_topic" default="/target_visual/pose"/>
  <arg name="visual_pose_cov_topic" default="/target_visual/pose_cov"/>
  <arg name="visual_valid_topic" default="/target_visual/valid"/>
  <arg name="visual_confidence_topic" default="/target_visual/confidence"/>
  <arg name="visual_marker_topic" default="/target_visual/marker"/>
  <arg name="depth_tf_lookup_timeout" default="0.05"/>
  <arg name="depth_allow_latest_tf_fallback" default="true"/>
  <arg name="depth_center_correction_enable" default="true"/>
  <arg name="depth_target_center_offset" default="0.25"/>
  <arg name="depth_min" default="0.5"/>
  <arg name="depth_max" default="25.0"/>
  <arg name="depth_z_min" default="1.8"/>
  <arg name="depth_z_max" default="4.8"/>
  <arg name="depth_min_cluster_size" default="8"/>

  <arg name="lidar_cloud_topic" default="/uav0/velodyne_points"/>
  <arg name="lidar_raw_topic" default="/uav0/velodyne_points_raw"/>
  <arg name="start_pointcloud2_relay" default="true"/>
  <arg name="start_lidar_detector" default="true"/>
  <arg name="relay_frame_id" default=""/>
  <arg name="lidar_range_min" default="0.7"/>
  <arg name="lidar_range_max" default="14.0"/>
  <arg name="lidar_z_min" default="2.0"/>
  <arg name="lidar_z_max" default="5.0"/>
  <arg name="lidar_min_cluster_size" default="5"/>
  <arg name="lidar_max_cluster_size" default="3000"/>
  <arg name="lidar_enable_shape_filter" default="true"/>
  <arg name="lidar_target_xy_size_min" default="0.05"/>
  <arg name="lidar_target_xy_size_max" default="1.20"/>
  <arg name="lidar_target_z_size_min" default="0.0"/>
  <arg name="lidar_target_z_size_max" default="0.80"/>
  <arg name="lidar_target_aspect_ratio_max" default="12.0"/>
  <arg name="lidar_expected_target_xy_size" default="0.55"/>
  <arg name="lidar_expected_target_z_size" default="0.25"/>
  <arg name="lidar_reference_distance_weight" default="0.65"/>
  <arg name="lidar_static_clutter_filter_enable" default="true"/>
  <arg name="lidar_static_clutter_min_candidates" default="2"/>
  <arg name="lidar_static_clutter_confirm_count" default="5"/>
  <arg name="lidar_static_clutter_cell_size" default="0.40"/>
  <arg name="lidar_static_clutter_max_spread" default="0.15"/>
  <arg name="lidar_static_clutter_startup_hold" default="true"/>
  <arg name="lidar_allow_reference_fallback" default="false"/>
  <arg name="lidar_use_estimator_gating" default="false"/>
  <arg name="lidar_continuity_enable" default="true"/>
  <arg name="lidar_continuity_max_age" default="1.0"/>
  <arg name="lidar_continuity_radius" default="2.5"/>
  <arg name="lidar_reject_far_without_reference" default="true"/>
  <arg name="lidar_max_ungated_range" default="10.0"/>

  <arg name="visual_min_confidence" default="0.55"/>
  <arg name="lidar_min_confidence" default="0.25"/>
  <arg name="max_observation_age" default="0.8"/>
  <arg name="prefer_visual" default="true"/>
  <arg name="consistency_threshold" default="0.8"/>
  <arg name="fusion_mode" default="priority"/>
  <arg name="require_consistency_for_visual" default="true"/>
  <arg name="visual_high_confidence" default="0.75"/>
  <arg name="visual_override_margin" default="0.30"/>
  <arg name="fusion_continuity_selection_enable" default="true"/>
  <arg name="fusion_continuity_selection_max_age" default="2.0"/>
  <arg name="fusion_continuity_selection_margin" default="0.40"/>
  <arg name="fusion_output_smoothing_alpha" default="0.92"/>
  <arg name="fusion_output_smoothing_max_jump" default="3.0"/>
  <arg name="fusion_reject_large_jumps" default="true"/>
  <arg name="fusion_max_jump_reference_age" default="2.0"/>
  <arg name="fusion_visual_max_jump_distance" default="2.5"/>
  <arg name="fusion_lidar_max_jump_distance" default="2.5"/>
  <arg name="fusion_lidar_fallback_visual_gap" default="0.45"/>
  <arg name="fusion_lidar_requires_recent_visual" default="false"/>
  <arg name="fusion_lidar_recent_visual_max_age" default="1.5"/>
  <arg name="fusion_lidar_recent_visual_gate_radius" default="2.0"/>
  <arg name="fusion_hold_last_on_none" default="true"/>
  <arg name="fusion_hold_last_max_age" default="0.35"/>
  <arg name="fusion_hold_confidence_scale" default="0.65"/>
  <arg name="fusion_clamp_output_motion" default="false"/>
  <arg name="fusion_max_output_speed_xy" default="5.0"/>
  <arg name="fusion_max_output_speed_z" default="5.0"/>
  <arg name="fusion_min_output_step_xy" default="0.5"/>
  <arg name="fusion_min_output_step_z" default="0.5"/>
  <arg name="fusion_clamp_output_z_bounds" default="true"/>
  <arg name="fusion_output_z_min" default="1.8"/>
  <arg name="fusion_output_z_max" default="4.8"/>
  <arg name="fusion_visual_z_filter_enable" default="true"/>
  <arg name="fusion_visual_z_min" default="1.8"/>
  <arg name="fusion_visual_z_max" default="4.8"/>
  <arg name="fusion_lidar_z_filter_enable" default="true"/>
  <arg name="fusion_lidar_z_min" default="1.8"/>
  <arg name="fusion_lidar_z_max" default="4.8"/>

  <arg name="estimator_model" default="kalman_cv"/>
  <arg name="kf_velocity_blend" default="0.0"/>
  <arg name="kf_measurement_noise" default="0.12"/>
  <arg name="use_observation_confidence" default="false"/>
  <arg name="min_update_confidence" default="0.0"/>
  <arg name="velocity_smoothing_alpha" default="0.35"/>
  <arg name="max_predict_only_time" default="0.8"/>
  <arg name="target_lost_timeout" default="1.5"/>
  <arg name="max_prediction_only_age" default="1.2"/>
  <arg name="freeze_prediction_after_lost" default="true"/>
  <arg name="predict_only_publish" default="true"/>
  <arg name="reject_observation_jumps" default="true"/>
  <arg name="max_observation_jump_speed_xy" default="8.0"/>
  <arg name="max_observation_jump_speed_z" default="8.0"/>
  <arg name="max_observation_jump_distance_xy" default="20.0"/>
  <arg name="max_observation_jump_distance_z" default="5.0"/>

  <arg name="target_input_mode" default="estimator"/>
  <arg name="lost_target_behavior" default="continue_predict"/>
  <arg name="predict_only_speed_scale" default="0.7"/>
  <arg name="lost_target_speed_scale" default="0.6"/>
  <arg name="Kp" default="2.5"/>
  <arg name="max_closing_speed" default="3.5"/>
  <arg name="capture_closing_speed" default="1.2"/>
  <arg name="capture_slowdown_distance" default="1.2"/>
  <arg name="stop_distance" default="0.15"/>
  <arg name="yaw_mode" default="face_guidance"/>
  <arg name="face_guidance_before_move" default="false"/>
  <arg name="yaw_gate_xy_scale" default="1.0"/>
  <arg name="allow_vertical_during_yaw_align" default="true"/>
  <arg name="terminal_guidance_enable" default="true"/>
  <arg name="terminal_switch_distance" default="0.9"/>
  <arg name="terminal_max_observation_age" default="0.9"/>
  <arg name="terminal_prediction_time" default="0.08"/>
  <arg name="terminal_vz_max" default="0.60"/>
  <arg name="terminal_z_deadband" default="0.08"/>
  <arg name="guidance_z_limit_enable" default="true"/>
  <arg name="guidance_z_min" default="1.2"/>
  <arg name="guidance_z_max" default="5.5"/>
  <arg name="altitude_guard_enable" default="true"/>
  <arg name="altitude_guard_min_z" default="1.5"/>
  <arg name="altitude_guard_max_z" default="5.5"/>
  <arg name="altitude_guard_gain" default="1.5"/>
  <arg name="altitude_guard_max_correction" default="1.0"/>
  <arg name="lost_recovery_enable" default="true"/>
  <arg name="lost_recovery_timeout" default="2.0"/>
  <arg name="lost_recovery_search_z" default="3.0"/>
  <arg name="lost_recovery_descent_speed" default="1.0"/>

  <arg name="capture_distance" default="0.80"/>
  <arg name="hard_capture_distance" default="0.50"/>
  <arg name="hold_time" default="0.15"/>
  <arg name="stop_on_capture_success" default="false"/>
  <arg name="latch_capture_success" default="false"/>

  <arg name="start_evaluator" default="true"/>
  <arg name="start_truth_compare" default="true"/>
  <arg name="evaluator_log_dir" default="$(env HOME)/uav_intercept_logs"/>
  <arg name="evaluator_sample_rate" default="20.0"/>
  <arg name="auto_arm" default="false"/>
  <arg name="auto_offboard" default="false"/>

  <include if="$(arg start_depth_detector)" file="$(find uav_truth_tracker)/launch/target_depth_detector_debug.launch">
    <arg name="detector_input_mode" value="depth_points"/>
    <arg name="fixed_frame" value="$(arg frame_id)"/>
    <arg name="depth_points_topic" value="$(arg depth_points_topic)"/>
    <arg name="depth_image_topic" value="$(arg depth_image_topic)"/>
    <arg name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <arg name="output_pose_topic" value="$(arg visual_pose_topic)"/>
    <arg name="pose_cov_topic" value="$(arg visual_pose_cov_topic)"/>
    <arg name="confidence_topic" value="$(arg visual_confidence_topic)"/>
    <arg name="valid_topic" value="$(arg visual_valid_topic)"/>
    <arg name="marker_topic" value="$(arg visual_marker_topic)"/>
    <arg name="tf_lookup_timeout" value="$(arg depth_tf_lookup_timeout)"/>
    <arg name="allow_latest_tf_fallback" value="$(arg depth_allow_latest_tf_fallback)"/>
    <arg name="center_correction_enable" value="$(arg depth_center_correction_enable)"/>
    <arg name="target_center_depth_offset" value="$(arg depth_target_center_offset)"/>
    <arg name="depth_min" value="$(arg depth_min)"/>
    <arg name="depth_max" value="$(arg depth_max)"/>
    <arg name="z_min" value="$(arg depth_z_min)"/>
    <arg name="z_max" value="$(arg depth_z_max)"/>
    <arg name="min_cluster_size" value="$(arg depth_min_cluster_size)"/>
    <arg name="min_publish_confidence" value="0.40"/>
  </include>

  <node if="$(arg start_pointcloud2_relay)" pkg="uav_truth_tracker" type="pointcloud_to_pointcloud2_relay.py"
        name="pointcloud_to_pointcloud2_relay" output="screen">
    <param name="input_topic" value="$(arg lidar_raw_topic)"/>
    <param name="output_topic" value="$(arg lidar_cloud_topic)"/>
    <param name="frame_id" value="$(arg relay_frame_id)"/>
  </node>

  <node if="$(arg start_lidar_detector)" pkg="uav_truth_tracker" type="target_lidar_detector_node.py"
        name="target_lidar_detector_node" output="screen">
    <param name="fixed_frame" value="$(arg frame_id)"/>
    <param name="lidar_cloud_topic" value="$(arg lidar_cloud_topic)"/>
    <param name="uav0_odom_topic" value="/uav0/mavros/local_position/odom"/>
    <param name="output_pose_topic" value="/target_observation/pose"/>
    <param name="pose_cov_topic" value="/target_observation/pose_cov"/>
    <param name="marker_topic" value="/target_observation/marker"/>
    <param name="debug_cloud_topic" value="/target_observation/debug_cloud"/>
    <param name="valid_topic" value="/target_observation/valid"/>
    <param name="confidence_topic" value="/target_observation/confidence"/>
    <param name="point_count_topic" value="/target_observation/point_count"/>
    <param name="range_min" value="$(arg lidar_range_min)"/>
    <param name="range_max" value="$(arg lidar_range_max)"/>
    <param name="z_min" value="$(arg lidar_z_min)"/>
    <param name="z_max" value="$(arg lidar_z_max)"/>
    <param name="min_cluster_size" value="$(arg lidar_min_cluster_size)"/>
    <param name="max_cluster_size" value="$(arg lidar_max_cluster_size)"/>
    <param name="enable_shape_filter" value="$(arg lidar_enable_shape_filter)"/>
    <param name="target_xy_size_min" value="$(arg lidar_target_xy_size_min)"/>
    <param name="target_xy_size_max" value="$(arg lidar_target_xy_size_max)"/>
    <param name="target_z_size_min" value="$(arg lidar_target_z_size_min)"/>
    <param name="target_z_size_max" value="$(arg lidar_target_z_size_max)"/>
    <param name="target_aspect_ratio_max" value="$(arg lidar_target_aspect_ratio_max)"/>
    <param name="expected_target_xy_size" value="$(arg lidar_expected_target_xy_size)"/>
    <param name="expected_target_z_size" value="$(arg lidar_expected_target_z_size)"/>
    <param name="reference_distance_weight" value="$(arg lidar_reference_distance_weight)"/>
    <param name="static_clutter_filter_enable" value="$(arg lidar_static_clutter_filter_enable)"/>
    <param name="static_clutter_min_candidates" value="$(arg lidar_static_clutter_min_candidates)"/>
    <param name="static_clutter_confirm_count" value="$(arg lidar_static_clutter_confirm_count)"/>
    <param name="static_clutter_cell_size" value="$(arg lidar_static_clutter_cell_size)"/>
    <param name="static_clutter_max_spread" value="$(arg lidar_static_clutter_max_spread)"/>
    <param name="static_clutter_startup_hold" value="$(arg lidar_static_clutter_startup_hold)"/>
    <param name="allow_reference_fallback" value="$(arg lidar_allow_reference_fallback)"/>
    <param name="use_estimator_gating" value="$(arg lidar_use_estimator_gating)"/>
    <param name="continuity_enable" value="$(arg lidar_continuity_enable)"/>
    <param name="continuity_max_age" value="$(arg lidar_continuity_max_age)"/>
    <param name="continuity_radius" value="$(arg lidar_continuity_radius)"/>
    <param name="reject_far_without_reference" value="$(arg lidar_reject_far_without_reference)"/>
    <param name="max_ungated_range" value="$(arg lidar_max_ungated_range)"/>
  </node>

  <node pkg="uav_truth_tracker" type="target_sensor_fusion_node.py"
        name="target_sensor_fusion_node" output="screen">
    <param name="visual_pose_topic" value="$(arg visual_pose_topic)"/>
    <param name="visual_pose_cov_topic" value="$(arg visual_pose_cov_topic)"/>
    <param name="visual_valid_topic" value="$(arg visual_valid_topic)"/>
    <param name="visual_confidence_topic" value="$(arg visual_confidence_topic)"/>
    <param name="lidar_pose_topic" value="/target_observation/pose"/>
    <param name="lidar_pose_cov_topic" value="/target_observation/pose_cov"/>
    <param name="lidar_valid_topic" value="/target_observation/valid"/>
    <param name="lidar_confidence_topic" value="/target_observation/confidence"/>
    <param name="output_pose_topic" value="/target_fused/pose"/>
    <param name="output_pose_cov_topic" value="/target_fused/pose_cov"/>
    <param name="output_valid_topic" value="/target_fused/valid"/>
    <param name="output_confidence_topic" value="/target_fused/confidence"/>
    <param name="output_source_topic" value="/target_fused/source"/>
    <param name="output_marker_topic" value="/target_fused/marker"/>
    <param name="visual_min_confidence" value="$(arg visual_min_confidence)"/>
    <param name="lidar_min_confidence" value="$(arg lidar_min_confidence)"/>
    <param name="max_observation_age" value="$(arg max_observation_age)"/>
    <param name="prefer_visual" value="$(arg prefer_visual)"/>
    <param name="consistency_threshold" value="$(arg consistency_threshold)"/>
    <param name="fusion_mode" value="$(arg fusion_mode)"/>
    <param name="require_consistency_for_visual" value="$(arg require_consistency_for_visual)"/>
    <param name="visual_high_confidence" value="$(arg visual_high_confidence)"/>
    <param name="visual_override_margin" value="$(arg visual_override_margin)"/>
    <param name="continuity_selection_enable" value="$(arg fusion_continuity_selection_enable)"/>
    <param name="continuity_selection_max_age" value="$(arg fusion_continuity_selection_max_age)"/>
    <param name="continuity_selection_margin" value="$(arg fusion_continuity_selection_margin)"/>
    <param name="output_smoothing_alpha" value="$(arg fusion_output_smoothing_alpha)"/>
    <param name="output_smoothing_max_jump" value="$(arg fusion_output_smoothing_max_jump)"/>
    <param name="reject_large_jumps" value="$(arg fusion_reject_large_jumps)"/>
    <param name="max_jump_reference_age" value="$(arg fusion_max_jump_reference_age)"/>
    <param name="visual_max_jump_distance" value="$(arg fusion_visual_max_jump_distance)"/>
    <param name="lidar_max_jump_distance" value="$(arg fusion_lidar_max_jump_distance)"/>
    <param name="lidar_fallback_visual_gap" value="$(arg fusion_lidar_fallback_visual_gap)"/>
    <param name="lidar_requires_recent_visual" value="$(arg fusion_lidar_requires_recent_visual)"/>
    <param name="lidar_recent_visual_max_age" value="$(arg fusion_lidar_recent_visual_max_age)"/>
    <param name="lidar_recent_visual_gate_radius" value="$(arg fusion_lidar_recent_visual_gate_radius)"/>
    <param name="hold_last_on_none" value="$(arg fusion_hold_last_on_none)"/>
    <param name="hold_last_max_age" value="$(arg fusion_hold_last_max_age)"/>
    <param name="hold_confidence_scale" value="$(arg fusion_hold_confidence_scale)"/>
    <param name="clamp_output_motion" value="$(arg fusion_clamp_output_motion)"/>
    <param name="max_output_speed_xy" value="$(arg fusion_max_output_speed_xy)"/>
    <param name="max_output_speed_z" value="$(arg fusion_max_output_speed_z)"/>
    <param name="min_output_step_xy" value="$(arg fusion_min_output_step_xy)"/>
    <param name="min_output_step_z" value="$(arg fusion_min_output_step_z)"/>
    <param name="clamp_output_z_bounds" value="$(arg fusion_clamp_output_z_bounds)"/>
    <param name="output_z_min" value="$(arg fusion_output_z_min)"/>
    <param name="output_z_max" value="$(arg fusion_output_z_max)"/>
    <param name="visual_z_filter_enable" value="$(arg fusion_visual_z_filter_enable)"/>
    <param name="visual_z_min" value="$(arg fusion_visual_z_min)"/>
    <param name="visual_z_max" value="$(arg fusion_visual_z_max)"/>
    <param name="lidar_z_filter_enable" value="$(arg fusion_lidar_z_filter_enable)"/>
    <param name="lidar_z_min" value="$(arg fusion_lidar_z_min)"/>
    <param name="lidar_z_max" value="$(arg fusion_lidar_z_max)"/>
  </node>

  <include file="$(find uav_truth_tracker)/launch/intercept_estimator_velocity_chase.launch">
    <arg name="frame_id" value="$(arg frame_id)"/>
    <arg name="target_mode" value="$(arg target_mode)"/>
    <arg name="target_height" value="$(arg target_height)"/>
    <arg name="target_radius" value="$(arg target_radius)"/>
    <arg name="uav1_speed" value="$(arg uav1_speed)"/>
    <arg name="target_center_x" value="$(arg target_center_x)"/>
    <arg name="target_center_y" value="$(arg target_center_y)"/>
    <arg name="target_direction" value="$(arg target_direction)"/>
    <arg name="z_amplitude" value="$(arg z_amplitude)"/>
    <arg name="z_period" value="$(arg z_period)"/>
    <arg name="uav1_motion_start_delay" value="$(arg uav1_motion_start_delay)"/>
    <arg name="observation_source" value="target_pose"/>
    <arg name="target_pose_topic" value="/target_fused/pose"/>
    <arg name="target_pose_cov_topic" value="/target_fused/pose_cov"/>
    <arg name="observation_confidence_topic" value="/target_fused/confidence"/>
    <arg name="observation_valid_topic" value="/target_fused/valid"/>
    <arg name="use_spawn_offsets" value="false"/>
    <arg name="capture_use_spawn_offsets" value="true"/>
    <arg name="evaluator_use_spawn_offsets" value="true"/>
    <arg name="estimator_model" value="$(arg estimator_model)"/>
    <arg name="kf_velocity_blend" value="$(arg kf_velocity_blend)"/>
    <arg name="kf_measurement_noise" value="$(arg kf_measurement_noise)"/>
    <arg name="use_observation_confidence" value="$(arg use_observation_confidence)"/>
    <arg name="min_update_confidence" value="$(arg min_update_confidence)"/>
    <arg name="velocity_smoothing_alpha" value="$(arg velocity_smoothing_alpha)"/>
    <arg name="max_observation_age" value="$(arg max_observation_age)"/>
    <arg name="max_prediction_only_age" value="$(arg max_prediction_only_age)"/>
    <arg name="max_predict_only_time" value="$(arg max_predict_only_time)"/>
    <arg name="target_lost_timeout" value="$(arg target_lost_timeout)"/>
    <arg name="freeze_prediction_after_lost" value="$(arg freeze_prediction_after_lost)"/>
    <arg name="predict_only_publish" value="$(arg predict_only_publish)"/>
    <arg name="reject_observation_jumps" value="$(arg reject_observation_jumps)"/>
    <arg name="max_observation_jump_speed_xy" value="$(arg max_observation_jump_speed_xy)"/>
    <arg name="max_observation_jump_speed_z" value="$(arg max_observation_jump_speed_z)"/>
    <arg name="max_observation_jump_distance_xy" value="$(arg max_observation_jump_distance_xy)"/>
    <arg name="max_observation_jump_distance_z" value="$(arg max_observation_jump_distance_z)"/>
    <arg name="target_input_mode" value="$(arg target_input_mode)"/>
    <arg name="lost_target_behavior" value="$(arg lost_target_behavior)"/>
    <arg name="predict_only_speed_scale" value="$(arg predict_only_speed_scale)"/>
    <arg name="lost_target_speed_scale" value="$(arg lost_target_speed_scale)"/>
    <arg name="Kp" value="$(arg Kp)"/>
    <arg name="max_closing_speed" value="$(arg max_closing_speed)"/>
    <arg name="capture_closing_speed" value="$(arg capture_closing_speed)"/>
    <arg name="capture_slowdown_distance" value="$(arg capture_slowdown_distance)"/>
    <arg name="stop_distance" value="$(arg stop_distance)"/>
    <arg name="yaw_mode" value="$(arg yaw_mode)"/>
    <arg name="face_guidance_before_move" value="$(arg face_guidance_before_move)"/>
    <arg name="yaw_gate_xy_scale" value="$(arg yaw_gate_xy_scale)"/>
    <arg name="allow_vertical_during_yaw_align" value="$(arg allow_vertical_during_yaw_align)"/>
    <arg name="terminal_guidance_enable" value="$(arg terminal_guidance_enable)"/>
    <arg name="terminal_switch_distance" value="$(arg terminal_switch_distance)"/>
    <arg name="terminal_max_observation_age" value="$(arg terminal_max_observation_age)"/>
    <arg name="terminal_prediction_time" value="$(arg terminal_prediction_time)"/>
    <arg name="terminal_vz_max" value="$(arg terminal_vz_max)"/>
    <arg name="terminal_z_deadband" value="$(arg terminal_z_deadband)"/>
    <arg name="guidance_z_limit_enable" value="$(arg guidance_z_limit_enable)"/>
    <arg name="guidance_z_min" value="$(arg guidance_z_min)"/>
    <arg name="guidance_z_max" value="$(arg guidance_z_max)"/>
    <arg name="altitude_guard_enable" value="$(arg altitude_guard_enable)"/>
    <arg name="altitude_guard_min_z" value="$(arg altitude_guard_min_z)"/>
    <arg name="altitude_guard_max_z" value="$(arg altitude_guard_max_z)"/>
    <arg name="altitude_guard_gain" value="$(arg altitude_guard_gain)"/>
    <arg name="altitude_guard_max_correction" value="$(arg altitude_guard_max_correction)"/>
    <arg name="lost_recovery_enable" value="$(arg lost_recovery_enable)"/>
    <arg name="lost_recovery_timeout" value="$(arg lost_recovery_timeout)"/>
    <arg name="lost_recovery_search_z" value="$(arg lost_recovery_search_z)"/>
    <arg name="lost_recovery_descent_speed" value="$(arg lost_recovery_descent_speed)"/>
    <arg name="capture_distance" value="$(arg capture_distance)"/>
    <arg name="hard_capture_distance" value="$(arg hard_capture_distance)"/>
    <arg name="hold_time" value="$(arg hold_time)"/>
    <arg name="stop_on_capture_success" value="$(arg stop_on_capture_success)"/>
    <arg name="latch_capture_success" value="$(arg latch_capture_success)"/>
    <arg name="start_evaluator" value="$(arg start_evaluator)"/>
    <arg name="evaluator_log_dir" value="$(arg evaluator_log_dir)"/>
    <arg name="evaluator_sample_rate" value="$(arg evaluator_sample_rate)"/>
    <arg name="auto_arm" value="$(arg auto_arm)"/>
    <arg name="auto_offboard" value="$(arg auto_offboard)"/>
  </include>

  <include if="$(arg start_truth_compare)" file="$(find uav_truth_tracker)/launch/target_truth_compare_debug.launch">
    <arg name="frame_id" value="$(arg frame_id)"/>
    <arg name="use_spawn_offsets" value="true"/>
    <arg name="visual_pose_topic" value="$(arg visual_pose_topic)"/>
    <arg name="visual_valid_topic" value="$(arg visual_valid_topic)"/>
    <arg name="visual_confidence_topic" value="$(arg visual_confidence_topic)"/>
  </include>
</launch>
