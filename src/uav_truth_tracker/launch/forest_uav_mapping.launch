<?xml version="1.0"?>
<launch>
  <!-- ================================================================
       forest_uav_mapping.launch — 一键启动所有 ROS 层组件

       替代 one_key_takeoff.sh 中 gnome-terminal 散开的节点，
       减少终端窗口数量。Gazebo / PX4 / MAVROS 仍需独立终端。

       启动顺序:
         1. Gazebo + world (独立终端)
         2. PX4 spawn (独立终端)
         3. MAVROS (独立终端)
         4. 本文件 — 包含下面所有组件

       包含: TF 胶水, TF 桥接/里程计, UGV marker, forest markers,
             depth preprocess, UAV→UGV 点云, EGO-Planner, RViz
       ================================================================ -->

  <!-- ===== 参数 ===== -->
  <arg name="enable_octomap" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="rviz_config" default="$(find ego_planner)/launch/forest_debug.rviz"/>
  <arg name="use_mavros" default="true"/>  <!-- false → Gazebo Odom Bridge -->
  <arg name="forest_world_file" default="$(find mobile_manipulator)/worlds/outdoor_city.world"/>
  <arg name="gazebo_uav_model_name" default="iris_depth_camera"/>

  <!-- ===== TF 静态变换 ===== -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_map_world"
        args="0 0 0 0 0 0 map world"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_camera"
        args="0.1 0 0 -1.5707963 0 -1.5707963 base_link camera_link"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_lidar"
        args="0 0 0.06 0 0 0 base_link uav0/velodyne_link"/>

  <!-- ===== 位姿 → TF + RViz marker ===== -->
  <node if="$(arg use_mavros)" pkg="uav_truth_tracker" type="mavros_tf_bridge.py"
        name="mavros_tf_bridge" output="screen">
    <param name="odom_topic" value="/mavros/local_position/odom"/>
    <param name="frame_id" value="map"/>
    <param name="publish_marker" value="true"/>
  </node>
  <node unless="$(arg use_mavros)" pkg="uav_truth_tracker"
        type="gazebo_odom_bridge.py" name="gazebo_odom_bridge" output="screen">
    <param name="model_name" value="$(arg gazebo_uav_model_name)"/>
    <param name="world_frame" value="map"/>
    <param name="body_frame" value="base_link"/>
    <param name="publish_rate" value="30.0"/>
  </node>

  <!-- Gazebo-pose debug marker. Keep this off /drone_visual because LiDAR TF,
       EGO, and control use the MAVROS local frame in the default stack. -->
  <node pkg="uav_truth_tracker" type="gazebo_uav_marker.py"
        name="gazebo_uav_marker" output="screen">
    <param name="uav_model_name" value="$(arg gazebo_uav_model_name)"/>
    <param name="frame_id" value="map"/>
    <param name="uav_marker_topic" value="/gazebo_drone_visual"/>
    <param name="uav_path_topic" value="/gazebo_drone_path"/>
    <param name="fallback_x" value="0.0"/>
    <param name="fallback_y" value="-18.0"/>
    <param name="fallback_z" value="1.5"/>
    <param name="fallback_yaw" value="1.5707963"/>
  </node>

  <!-- Lightweight forest corridor visualization in RViz. Gazebo renders the
       real world; this marker copy makes the obstacles visible in RViz too. -->
  <node pkg="uav_truth_tracker" type="forest_world_markers.py"
        name="forest_world_markers" output="screen">
    <param name="world_file" value="$(arg forest_world_file)"/>
    <param name="frame_id" value="map"/>
    <param name="topic" value="/forest_world_markers"/>
  </node>

  <!-- ===== UGV 模型 (Husky UR5) ===== -->
  <arg name="ugv_ws" default="$(env HOME)/Air-Ground-Collaborative-Manupulation"/>
  <arg name="ugv_urdf" default="$(arg ugv_ws)/src/husky_ur5_moveit_config/config/gazebo_husky_ur5.urdf"/>
  <node pkg="uav_truth_tracker" type="ugv_robot_model_helper.py" name="ugv_model_helper"
        output="screen" if="$(eval arg('ugv_urdf') != '')">
    <param name="urdf_file" value="$(arg ugv_urdf)"/>
    <param name="link_prefix" value="ugv_"/>
    <param name="root_frame" value="map"/>
    <param name="x" value="2.5"/>
    <param name="y" value="-18.0"/>
    <param name="z" value="0.25"/>
    <param name="yaw" value="0.0"/>
    <param name="start_robot_state_publisher" value="true"/>
  </node>

  <!-- UGV robot_state_publisher moved into ugv_robot_model_helper (start_rsp=true) -->

  <!-- ===== 深度预处理 → /depth/image_dilated ===== -->
  <include file="$(find forest_avoidance_utils)/launch/forest_utils.launch"/>

  <!-- ===== UAV LiDAR → 世界系点云 (供 UGV 使用) ===== -->
  <include file="$(find uav_truth_tracker)/launch/uav_points_to_ugv.launch">
    <arg name="raw_input_topic" value="/uav0/velodyne_points_raw"/>
    <arg name="input_topic" value="/uav0/mapping/velodyne_points_sensor"/>
    <arg name="output_topic" value="/uav0/mapping/points_world"/>
    <arg name="target_frame" value="map"/>
    <arg name="publish_rate" value="0.0"/>
    <arg name="imu_topic" value="/mavros/imu/data"/>
    <arg name="odom_topic" value="/mavros/local_position/odom"/>
    <!-- Use the odometry stamp for the filtered LiDAR cloud before TF projection.
         Gazebo LiDAR and MAVROS odom can be slightly offset in time; stamping
         with the odom used by the relay reduces map smearing while the UAV moves. -->
    <arg name="stamp_with_odom" value="true"/>
    <!-- Drop fast-turn / high-speed scans; they are the main source of smeared maps.
         放宽以"持续记录"：转弯门槛 0.8->1.5 rad/s(只有很快的自旋才丢，普通转弯照记)，
         odom 时效 0.30->1.0s(odom 偶尔抖动/滞后时也不再整片丢帧导致"建着建着不记了")。 -->
    <arg name="max_linear_velocity" value="2.0"/>
    <arg name="max_angular_velocity" value="0.0"/>
    <arg name="max_odom_angular_velocity" value="1.5"/>
    <arg name="max_imu_age" value="999.0"/>
    <arg name="max_odom_age" value="1.0"/>
    <!-- Range filter: this lightweight LiDAR is 16m max. Keep a margin so max-range
         no-hit returns do not become a fake boundary shell in the map. -->
    <arg name="min_range" value="0.35"/>
    <arg name="max_range" value="15.0"/>
    <arg name="sensor_max_range" value="16.0"/>
    <arg name="drop_max_range_returns" value="true"/>
    <arg name="max_range_margin" value="0.8"/>
    <arg name="drop_far_boundary_band" value="false"/>
    <arg name="range_edge_margin" value="0.0"/>
    <!-- Self-filter ON: remove drone body + rotor points -->
    <arg name="self_filter_enabled" value="true"/>
    <!-- Mild sparse outlier removal: enough to remove boundary speckles without
         deleting tree trunks or real obstacles. -->
    <arg name="neighbor_voxel_size" value="0.16"/>
    <arg name="min_neighbors" value="2"/>
    <arg name="relay_voxel_size" value="0.06"/>
    <arg name="leaf_size" value="0.0"/>
    <arg name="enable_voxel_filter" value="false"/>
    <!-- Repeat the range filter after TF as a safety net. -->
    <arg name="enable_range_filter" value="true"/>
    <arg name="allow_latest_tf_fallback" value="false"/>
    <arg name="tf_lookup_timeout" value="0.20"/>
    <!-- Map recorder: require repeated observations so single-frame boundary returns
         and pose jitter do not enter the saved map. -->
    <arg name="start_map_recorder" value="true"/>
    <arg name="map_output_dir" value="$(env HOME)/pointcloud_maps"/>
    <arg name="map_name" value="uav_points_map"/>
    <!-- min_observations=1：单次飞过(单帧)的区域也记录下来，否则全局规划高效单程飞行时
         很多地方只看一次会被丢 → "后面不记录"。噪点交给 clean_pcd + 投影器去处理。 -->
    <arg name="map_min_observations" value="1"/>
    <arg name="map_voxel_leaf_size" value="0.10"/>
    <arg name="map_publish_rate" value="2.0"/>
    <arg name="map_drop_flat_ground" value="false"/>
    <!-- ground_filter_mode=none saves ALL ground + obstacle returns.
         The projector (v4) handles ground-surface extraction with a
         large-window median filter — it needs raw point density, not
         decimated terrain samples. -->
    <!-- 改回 none：保留地面点云，UGV 的代价图要靠地面高程算【坡度】来判可通行(上坡)。
         地面不再是"无用clutter"，投影器用它算 DEM→坡度：缓坡=可走(能爬)、陡坡=障碍。 -->
    <arg name="map_ground_filter_mode" value="none"/>
    <arg name="map_keep_terrain_points" value="false"/>
    <arg name="map_terrain_cell_size" value="0.25"/>
    <arg name="map_ground_z" value="0.0"/>
    <arg name="map_ground_clearance" value="0.3"/>
    <arg name="map_obstacle_height_above_ground" value="0.45"/>
    <arg name="map_ground_xy_cell_size" value="0.25"/>
    <arg name="map_ray_clearing_enabled" value="true"/>
    <arg name="map_ray_clear_sensor_frame" value="uav0/velodyne_link"/>
    <arg name="map_ray_clear_max_range" value="15.0"/>
    <arg name="map_ray_clear_min_range" value="0.5"/>
    <arg name="map_ray_clear_step_size" value="0.20"/>
    <arg name="map_ray_clear_keep_last_voxels" value="3"/>
    <arg name="map_ray_clear_decimation" value="8"/>
    <arg name="map_tf_lookup_timeout" value="0.20"/>
  </include>

  <!-- ===== EGO-Planner (深度相机避障) ===== -->
  <!-- EGO 规划地图以世界原点为中心, 覆盖 x,y ∈ [-map/2, +map/2]. 城很大(模型排到
       x=175), 地图太小无人机一往外飞目标就出界 → EGO 判"terminal in obstacle"卡死.
       放大到 200 (覆盖 ±100m); 配合粗分辨率 0.3 控制内存(高空空地图无需细分辨率). -->
  <arg name="map_size_x" value="200.0"/>
  <arg name="map_size_y" value="200.0"/>
  <arg name="map_size_z" value="15.0"/>
  <arg name="odom_topic" value="/mavros/local_position/odom"/>

  <!-- 建图飞行高度: 抬到所有楼之上(outdoor_city 楼最高 ~8m). 点击目标/航点都用
       这个高度. 配合下面 ground_filter_margin=10, EGO 在巡航高度看不到任何障碍 →
       永远不会"目标在障碍里"、不会卡, 自由飞从上往下扫图.
       想压低/抬高: roslaunch ... flight_height:=10.0 (但别低于楼高+2m) -->
  <!-- low_altitude:=true 一键切"低空穿街"建图：压低高度 + 打开 EGO 避楼(depth) +
       换成贯穿空地的航点(从地图算出、连线不穿楼)。默认 false=原 12m 俯扫，不受影响。 -->
  <arg name="low_altitude" default="false"/>
  <arg name="flight_height" default="$(eval 4.0 if arg('low_altitude')=='true' else 12.0)"/>
  <!-- 飞行速度(m/s)。>1.5 点云录不全+拖影；低空建图取 1.2 稳。可被 one_key_takeoff 覆盖 -->
  <arg name="max_vel" default="$(eval 1.2 if arg('low_altitude')=='true' else 1.5)"/>
  <!-- EGO 地面过滤余量：低空=0.5(滤地面、看得见楼 → 能避障)，12m=10(地图空、不避)。
       提为顶层 arg，让 one_key_takeoff 用 bash 算死并显式传，避免 eval 没生效 EGO 变瞎。 -->
  <arg name="ground_filter_margin" default="$(eval 0.5 if arg('low_altitude')=='true' else 10.0)"/>
  <!-- 全局规划前端：低空(楼间)时默认开——A* 在累积地图上搜绕楼大路，喂 EGO 子目标，
       EGO 仍做局部避障。12m 俯扫飞楼顶上不需要(开了反而绕没必要的远路)，默认随 low_altitude。 -->
  <arg name="use_global_planner" default="$(arg low_altitude)"/>

  <include file="$(find uav_truth_tracker)/launch/forest_param.xml">
    <arg name="map_size_x_" value="$(arg map_size_x)"/>
    <arg name="map_size_y_" value="$(arg map_size_y)"/>
    <arg name="map_size_z_" value="$(arg map_size_z)"/>
    <arg name="odometry_topic" value="$(arg odom_topic)"/>
    <arg name="camera_pose_topic" value="/mavros/local_position/pose"/>
    <arg name="depth_topic" value="/depth/image_dilated"/>
    <arg name="cloud_topic" value="fake"/>
    <arg name="cx" value="320.0"/>
    <arg name="cy" value="180.0"/>
    <arg name="fx" value="343.158"/>
    <arg name="fy" value="343.158"/>
    <!-- 速度: 太快(>~1.5)点云来不及录 + 拖影(LiDAR→world 的 TF 滞后)。低空建图要稳，取 1.2 -->
    <arg name="max_vel" value="$(arg max_vel)"/>
    <arg name="max_acc" value="1.5"/>
    <arg name="planning_horizon" value="8.0"/>
    <arg name="ground_filter_margin" value="$(arg ground_filter_margin)"/>
    <!-- 低空避障：横向感知范围 8→15m(配合深度 15m)，让 EGO 提前把楼建进障碍图、
         A* 有距离绕行。z 和规划池保持官方默认(2.5 / 200·80)——之前乱调 pool_z 把 A* 搞挂了。 -->
    <arg name="local_update_range_xy" value="$(eval 15.0 if arg('low_altitude')=='true' else 8.0)"/>
    <arg name="local_update_range_z"  value="2.5"/>
    <arg name="pool_size_xy" value="200"/>
    <arg name="pool_size_z"  value="80"/>
    <arg name="skip_pixel" value="2"/>
    <arg name="flight_type" value="1"/>
    <arg name="point_num" value="5"/>
    <!-- low_altitude 时换成贯穿空地的穿街航点(从地图算出, 相邻连线 0 穿楼)；否则原航点 -->
    <arg name="point0_x" value="$(eval -11.9 if arg('low_altitude')=='true' else 0.0)"/>
    <arg name="point0_y" value="$(eval 9.4 if arg('low_altitude')=='true' else -15.0)"/>
    <arg name="point0_z" value="$(arg flight_height)"/>
    <arg name="point1_x" value="$(eval -4.9 if arg('low_altitude')=='true' else 3.0)"/>
    <arg name="point1_y" value="$(eval 9.4 if arg('low_altitude')=='true' else 0.0)"/>
    <arg name="point1_z" value="$(arg flight_height)"/>
    <arg name="point2_x" value="$(eval 2.1 if arg('low_altitude')=='true' else 0.0)"/>
    <arg name="point2_y" value="$(eval 8.9 if arg('low_altitude')=='true' else 10.0)"/>
    <arg name="point2_z" value="$(arg flight_height)"/>
    <arg name="point3_x" value="$(eval 10.1 if arg('low_altitude')=='true' else -3.0)"/>
    <arg name="point3_y" value="$(eval 5.9 if arg('low_altitude')=='true' else 0.0)"/>
    <arg name="point3_z" value="$(arg flight_height)"/>
    <arg name="point4_x" value="$(eval 23.1 if arg('low_altitude')=='true' else 0.0)"/>
    <arg name="point4_y" value="$(eval 9.4 if arg('low_altitude')=='true' else -15.0)"/>
    <arg name="point4_z" value="$(arg flight_height)"/>
  </include>

  <!-- EGO-Planner 辅助节点 -->
  <node pkg="ego_planner" name="traj_server" type="traj_server" output="screen">
    <remap from="/position_cmd" to="planning/pos_cmd"/>
    <remap from="/odom_world" to="$(arg odom_topic)"/>
    <param name="traj_server/time_forward" value="1.0" type="double"/>
  </node>
  <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator"
        output="screen">
    <remap from="~odom" to="$(arg odom_topic)"/>
    <remap from="~goal" to="/goal_elevated"/>
    <remap from="~traj_start_trigger" to="/traj_start_trigger"/>
    <param name="waypoint_type" value="manual-lonely-waypoint"/>
  </node>
  <!-- 全局路径规划前端：用户目标 -> A* 绕楼 -> 子目标(/global_subgoal) -->
  <node if="$(arg use_global_planner)" pkg="forest_avoidance_utils"
        name="global_path_planner" type="global_path_planner.py" output="screen">
    <param name="cloud_topic"     value="/uav0/mapping/points_world"/>
    <param name="odom_topic"      value="$(arg odom_topic)"/>
    <param name="goal_topic"      value="/move_base_simple/goal"/>
    <param name="output_topic"    value="/goal_elevated"/>   <!-- 直发 waypoint_generator，绕过 goal_elevator -->
    <param name="goal_z"          value="$(arg flight_height)"/>
    <param name="obstacle_height" value="1.5"/>     <!-- 高出【本地地面】>1.5m=突起(楼/树);缓坡山丘地面整体抬高、不算障碍→无人机飞越爬坡 -->
    <!-- 既能绕楼、又能穿树林：只把占地>=此面积(m²)的大块(楼/墙)留给全局A*绕行，更小的(树)
         滤掉、交给 EGO 局部避障穿过去。否则树林里 A* 被一堆"树墙"堵成无解、无人机原地不动。 -->
    <param name="min_obstacle_area" value="10.0"/>
    <param name="ground_window"   value="2.0"/>     <!-- 本地地面估计窗口(m)，判"相对突起" -->
    <param name="inflate"         value="1.5"/>      <!-- 障碍膨胀(m)：建图要贴近,留1.5m够避碰又能近距扫楼;太大(3)绕太远漏建图 -->
    <param name="resolution"      value="0.5"/>
    <param name="half_extent"     value="100.0"/>    <!-- 全局图 ±100m -->
    <param name="reach_radius"    value="1.5"/>      <!-- 沿路推进的判定半径 -->
    <param name="lookahead"       value="7.0"/>      <!-- 纯追踪萝卜点前瞻(贴着全局路喂EGO一条无碰短直线) -->
    <param name="min_replan_interval" value="0.5"/>  <!-- 重规划最小间隔，路稳定不乱变 -->
    <!-- safe_dist 必须 << inflate(1.5)，否则正常贴路飞就一直触发退后→来回飞。
         只在真危险(<0.8m, 比路的1.5m余量还近)才退后,且只退到刚好脱险,不大幅倒飞。 -->
    <param name="safe_dist"       value="0.8"/>      <!-- 近于0.8m(已穿进路的余量内)才退后 -->
    <param name="retreat_dist"    value="2.0"/>      <!-- 轻退2m脱险即可，别大幅倒飞 -->
    <param name="min_subgoal_z"   value="2.0"/>      <!-- 子目标最低高度(m)：地面噪点拉低估计时不把无人机往地上压 -->
    <param name="enable_retreat"  value="false"/>    <!-- 反应式贴楼退后默认关：局部避障交给 EGO，避免前进/后退来回振荡 -->
  </node>

  <!-- goal_elevator：仅在【不开全局规划】时用(直接把点击目标抬高发给 EGO)。
       开全局规划时由 global_path_planner 直发 /goal_elevated，这里不启动，避免双发冲突。 -->
  <node unless="$(arg use_global_planner)" pkg="forest_avoidance_utils"
        name="goal_elevator" type="goal_elevator.py" output="screen">
    <param name="goal_z" value="$(arg flight_height)"/>
  </node>
  <node pkg="forest_avoidance_utils" name="trajectory_logger"
        type="trajectory_logger.py" output="screen">
    <param name="actual_topic" value="/mavros/local_position/pose"/>
    <param name="desired_topic" value="/planning/pos_cmd"/>
    <param name="output_dir" value="$(env HOME)/trajectory_logs"/>
    <param name="max_cmd_age" value="0.5"/>
  </node>

  <!-- ===== OctoMap 3D 建图 (32-line LiDAR) ===== -->
  <include if="$(arg enable_octomap)"
           file="$(find forest_avoidance_utils)/launch/forest_octomap.launch">
    <arg name="raw_lidar_topic" value="/uav0/velodyne_points_raw"/>
    <arg name="cloud_topic" value="/uav0/velodyne_points"/>
    <arg name="lidar_frame" value="uav0/velodyne_link"/>
    <arg name="imu_topic" value="/mavros/imu/data"/>
    <arg name="odom_topic" value="/mavros/local_position/odom"/>
    <arg name="frame_id" value="map"/>
    <arg name="autosave_updates_latest" value="true"/>
    <arg name="start_lidar_relay" value="true"/>
    <!-- Relax motion filter so relay doesn't drop frames -->
    <arg name="max_linear_velocity" value="0.0"/>
    <arg name="max_angular_velocity" value="0.0"/>
    <arg name="max_odom_angular_velocity" value="0.0"/>
    <arg name="max_imu_age" value="999.0"/>
    <arg name="max_odom_age" value="999.0"/>
  </include>

  <!-- ===== RViz ===== -->
  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(arg rviz_config)" output="screen"/>

  <!-- ===== GPS 锚定：建图时自动记录 UAV map 原点(UTM) 到 sidecar，
       供 UGV 侧 pcd_to_occupancy_map 开机自动对齐，无需手填经纬度。 ===== -->
  <node pkg="uav_truth_tracker" type="uav_map_origin_saver.py"
        name="uav_map_origin_saver" output="screen">
    <param name="origin_file" value="$(env HOME)/pointcloud_maps/uav_map_origin.yaml"/>
  </node>

</launch>
