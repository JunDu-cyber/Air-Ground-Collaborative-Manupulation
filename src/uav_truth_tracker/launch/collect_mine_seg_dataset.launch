<launch>
  <!-- Starts dataset-only nodes. Gazebo/PX4/EGO must already be running with
       models/iris_depth_camera_lidar_mine/model.sdf. -->
  <arg name="dataset_dir" default="$(env HOME)/mine_yolo_dataset"/>
  <arg name="target_images" default="8000"/>
  <arg name="session" default="mine_collection"/>
  <arg name="session_size" default="500"/>
  <arg name="sample_rate" default="2.0"/>
  <arg name="seed" default="42"/>
  <arg name="uav_base_frame" default="base_link"/>
  <arg name="goal_topic" default="/move_base_simple/goal"/>
  <arg name="world_name" default="mine_dataset"/>
  <arg name="domain_tag" default="flight"/>
  <arg name="randomize" default="true"/>
  <arg name="auto_waypoints" default="true"/>
  <arg name="depth_tolerance" default="0.008"/>
  <arg name="sync_slop" default="0.04"/>
  <arg name="scene_settle_time" default="0.25"/>
  <arg name="hard_distractor_ratio" default="0.25"/>

  <!-- Optical axes: x right=-base_y, y down=-base_x, z forward=-base_z. -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_mine_camera"
        args="0 0 -0.07 0.70710678 -0.70710678 0 0 $(arg uav_base_frame) mine_camera_optical_frame"/>

  <node if="$(arg randomize)" pkg="uav_truth_tracker" type="mine_dataset_randomizer.py"
        name="mine_dataset_randomizer" output="screen">
    <param name="seed" value="$(arg seed)"/>
    <param name="mine_count" value="10"/>
    <param name="distractor_count" value="12"/>
    <param name="refresh_period" value="75.0"/>
    <param name="hard_distractor_ratio" value="$(arg hard_distractor_ratio)"/>
  </node>

  <node if="$(arg auto_waypoints)" pkg="uav_truth_tracker" type="mine_collection_waypoints.py"
        name="mine_collection_waypoints" output="screen">
    <param name="goal_topic" value="$(arg goal_topic)"/>
    <param name="seed" value="$(eval int(arg('seed')) + 1)"/>
    <param name="dwell" value="6.0"/>
    <param name="negative_goal_ratio" value="0.30"/>
  </node>

  <node pkg="uav_truth_tracker" type="collect_mine_seg_dataset_node.py"
        name="collect_mine_seg_dataset" output="screen" required="true">
    <param name="dataset_dir" value="$(arg dataset_dir)"/>
    <param name="max_new_images" value="$(arg target_images)"/>
    <param name="session" value="$(arg session)"/>
    <param name="session_size" value="$(arg session_size)"/>
    <param name="split" value="auto"/>
    <param name="sample_rate" value="$(arg sample_rate)"/>
    <param name="negative_ratio" value="0.30"/>
    <param name="world_name" value="$(arg world_name)"/>
    <param name="domain_tag" value="$(arg domain_tag)"/>
    <param name="allow_latest_tf" value="false"/>
    <param name="depth_visibility" value="true"/>
    <param name="depth_tolerance" value="$(arg depth_tolerance)"/>
    <param name="sync_slop" value="$(arg sync_slop)"/>
    <param name="dedupe_hamming" value="-1"/>
    <param name="require_camera_settle" value="false"/>
    <param name="scene_settle_time" value="$(arg scene_settle_time)"/>
  </node>
</launch>
