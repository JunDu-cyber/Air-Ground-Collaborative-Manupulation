<launch>
  <arg name="dataset_dir" default="$(env HOME)/uav_yolo_dataset"/>
  <arg name="max_images" default="3000"/>
  <arg name="max_new_images" default="0"/>
  <arg name="sample_rate" default="5.0"/>
  <arg name="dataset_tag" default="hover_session"/>
  <arg name="target_mode" default="circle_z_sine"/>
  <arg name="uav1_speed" default="0.6"/>
  <arg name="z_amplitude" default="0.5"/>
  <arg name="auto_arm" default="true"/>
  <arg name="auto_offboard" default="true"/>

  <node pkg="uav_truth_tracker" type="mavros_hover_node.py"
        name="uav0_dataset_hover" output="screen">
    <param name="mavros_ns" value="/uav0/mavros"/>
    <param name="x" value="0.0"/>
    <param name="y" value="0.0"/>
    <param name="takeoff_z" value="3.0"/>
    <param name="auto_arm" value="$(arg auto_arm)"/>
    <param name="auto_offboard" value="$(arg auto_offboard)"/>
  </node>

  <node pkg="uav_truth_tracker" type="uav1_motion_node.py"
        name="uav1_motion_node" output="screen">
    <param name="mavros_ns" value="/uav1/mavros"/>
    <param name="frame_id" value="map"/>
    <param name="mode" value="$(arg target_mode)"/>
    <param name="speed" value="$(arg uav1_speed)"/>
    <param name="z_amplitude" value="$(arg z_amplitude)"/>
    <param name="auto_arm" value="$(arg auto_arm)"/>
    <param name="auto_offboard" value="$(arg auto_offboard)"/>
  </node>

  <include file="$(find uav_truth_tracker)/launch/collect_uav_yolo_dataset.launch">
    <arg name="dataset_dir" value="$(arg dataset_dir)"/>
    <arg name="max_images" value="$(arg max_images)"/>
    <arg name="max_new_images" value="$(arg max_new_images)"/>
    <arg name="sample_rate" value="$(arg sample_rate)"/>
    <arg name="dataset_tag" value="$(arg dataset_tag)"/>
  </include>
</launch>
