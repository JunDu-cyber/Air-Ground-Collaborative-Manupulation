<launch>
  <arg name="detector_input_mode" default="depth_points"/>
  <arg name="fixed_frame" default="map"/>
  <arg name="depth_points_topic" default="/iris0/camera/depth/points"/>
  <arg name="depth_image_topic" default="/iris0/camera/depth/image_raw"/>
  <arg name="camera_info_topic" default="/iris0/camera/depth/camera_info"/>
  <arg name="uav0_odom_topic" default="/uav0/mavros/local_position/odom"/>
  <arg name="estimator_state_topic" default="/target_estimator/state"/>
  <arg name="output_pose_topic" default="/target_visual/pose"/>
  <arg name="pose_cov_topic" default="/target_visual/pose_cov"/>
  <arg name="confidence_topic" default="/target_visual/confidence"/>
  <arg name="valid_topic" default="/target_visual/valid"/>
  <arg name="marker_topic" default="/target_visual/marker"/>
  <arg name="object_cloud_topic" default="/target_visual/object_cloud"/>
  <arg name="source_debug_image_topic" default="/target_visual/source_debug_image"/>

  <arg name="depth_min" default="0.5"/>
  <arg name="depth_max" default="20.0"/>
  <arg name="z_min" default="1.0"/>
  <arg name="z_max" default="8.0"/>
  <arg name="cluster_tolerance" default="0.20"/>
  <arg name="min_cluster_size" default="10"/>
  <arg name="max_cluster_size" default="50000"/>
  <arg name="target_size_min" default="0.10"/>
  <arg name="target_size_max" default="2.0"/>
  <arg name="use_estimator_roi" default="false"/>
  <arg name="roi_radius" default="2.0"/>
  <arg name="max_jump_distance" default="3.0"/>
  <arg name="continuity_weight" default="1.0"/>
  <arg name="publish_object_cloud" default="true"/>
  <arg name="max_sample_points" default="25000"/>
  <arg name="voxel_leaf_size" default="0.04"/>
  <arg name="process_rate" default="10.0"/>
  <arg name="min_publish_confidence" default="0.45"/>
  <arg name="tf_lookup_timeout" default="0.05"/>
  <arg name="allow_latest_tf_fallback" default="true"/>
  <arg name="center_correction_enable" default="true"/>
  <arg name="target_center_depth_offset" default="0.25"/>
  <arg name="continuity_reject_enable" default="true"/>
  <arg name="continuity_reject_max_age" default="1.0"/>

  <arg name="start_camera_tf" default="false"/>
  <arg name="camera_child_frame" default="camera_link"/>
  <arg name="camera_offset_x" default="0.1"/>
  <arg name="camera_offset_y" default="0.0"/>
  <arg name="camera_offset_z" default="0.0"/>
  <arg name="camera_offset_roll" default="-1.57079632679"/>
  <arg name="camera_offset_pitch" default="0.0"/>
  <arg name="camera_offset_yaw" default="-1.57079632679"/>

  <node if="$(arg start_camera_tf)" name="target_depth_camera_tf_broadcaster"
        pkg="uav_truth_tracker" type="camera_tf_broadcaster.py" output="screen">
    <param name="odom_topic" value="$(arg uav0_odom_topic)"/>
    <param name="parent_frame" value="$(arg fixed_frame)"/>
    <param name="child_frame" value="$(arg camera_child_frame)"/>
    <param name="offset_x" value="$(arg camera_offset_x)"/>
    <param name="offset_y" value="$(arg camera_offset_y)"/>
    <param name="offset_z" value="$(arg camera_offset_z)"/>
    <param name="offset_roll" value="$(arg camera_offset_roll)"/>
    <param name="offset_pitch" value="$(arg camera_offset_pitch)"/>
    <param name="offset_yaw" value="$(arg camera_offset_yaw)"/>
  </node>

  <node pkg="uav_truth_tracker" type="target_depth_detector_node.py"
        name="target_depth_detector_node" output="screen">
    <param name="detector_input_mode" value="$(arg detector_input_mode)"/>
    <param name="fixed_frame" value="$(arg fixed_frame)"/>
    <param name="depth_points_topic" value="$(arg depth_points_topic)"/>
    <param name="depth_image_topic" value="$(arg depth_image_topic)"/>
    <param name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <param name="uav0_odom_topic" value="$(arg uav0_odom_topic)"/>
    <param name="estimator_state_topic" value="$(arg estimator_state_topic)"/>
    <param name="output_pose_topic" value="$(arg output_pose_topic)"/>
    <param name="pose_cov_topic" value="$(arg pose_cov_topic)"/>
    <param name="confidence_topic" value="$(arg confidence_topic)"/>
    <param name="valid_topic" value="$(arg valid_topic)"/>
    <param name="marker_topic" value="$(arg marker_topic)"/>
    <param name="object_cloud_topic" value="$(arg object_cloud_topic)"/>
    <param name="source_debug_image_topic" value="$(arg source_debug_image_topic)"/>
    <param name="depth_min" value="$(arg depth_min)"/>
    <param name="depth_max" value="$(arg depth_max)"/>
    <param name="z_min" value="$(arg z_min)"/>
    <param name="z_max" value="$(arg z_max)"/>
    <param name="cluster_tolerance" value="$(arg cluster_tolerance)"/>
    <param name="min_cluster_size" value="$(arg min_cluster_size)"/>
    <param name="max_cluster_size" value="$(arg max_cluster_size)"/>
    <param name="target_size_min" value="$(arg target_size_min)"/>
    <param name="target_size_max" value="$(arg target_size_max)"/>
    <param name="use_estimator_roi" value="$(arg use_estimator_roi)"/>
    <param name="roi_radius" value="$(arg roi_radius)"/>
    <param name="max_jump_distance" value="$(arg max_jump_distance)"/>
    <param name="continuity_weight" value="$(arg continuity_weight)"/>
    <param name="publish_object_cloud" value="$(arg publish_object_cloud)"/>
    <param name="max_sample_points" value="$(arg max_sample_points)"/>
    <param name="voxel_leaf_size" value="$(arg voxel_leaf_size)"/>
    <param name="process_rate" value="$(arg process_rate)"/>
    <param name="min_publish_confidence" value="$(arg min_publish_confidence)"/>
    <param name="tf_lookup_timeout" value="$(arg tf_lookup_timeout)"/>
    <param name="allow_latest_tf_fallback" value="$(arg allow_latest_tf_fallback)"/>
    <param name="center_correction_enable" value="$(arg center_correction_enable)"/>
    <param name="target_center_depth_offset" value="$(arg target_center_depth_offset)"/>
    <param name="continuity_reject_enable" value="$(arg continuity_reject_enable)"/>
    <param name="continuity_reject_max_age" value="$(arg continuity_reject_max_age)"/>
  </node>
</launch>
