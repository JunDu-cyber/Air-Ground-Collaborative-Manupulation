<launch>
  <arg name="model_path" default="$(env HOME)/uav_yolo_runs/uav_detector_v2/weights/best.pt"/>
  <arg name="min_confidence" default="0.45"/>
  <arg name="process_rate" default="10.0"/>

  <node pkg="uav_truth_tracker" type="target_yolo_detector_node.py"
        name="target_yolo_detector_node" output="screen">
    <param name="model_path" value="$(arg model_path)"/>
    <param name="rgb_topic" value="/iris0/camera/rgb/image_raw"/>
    <param name="depth_topic" value="/iris0/camera/depth/image_raw"/>
    <param name="camera_info_topic" value="/iris0/camera/rgb/camera_info"/>
    <param name="fixed_frame" value="map"/>
    <param name="target_class_name" value="uav"/>
    <param name="target_class_id" value="0"/>
    <param name="min_confidence" value="$(arg min_confidence)"/>
    <param name="process_rate" value="$(arg process_rate)"/>
    <param name="output_pose_topic" value="/target_semantic/pose"/>
    <param name="output_pose_cov_topic" value="/target_semantic/pose_cov"/>
    <param name="output_valid_topic" value="/target_semantic/valid"/>
    <param name="output_confidence_topic" value="/target_semantic/confidence"/>
    <param name="output_marker_topic" value="/target_semantic/marker"/>
    <param name="output_debug_image_topic" value="/target_semantic/debug_image"/>
  </node>
</launch>
