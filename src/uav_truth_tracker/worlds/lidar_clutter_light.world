<?xml version="1.0"?>
<sdf version="1.5">
  <world name="lidar_clutter_light">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="low_crate">
      <static>true</static>
      <pose>2.0 1.8 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 1.2</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tall_pole">
      <static>true</static>
      <pose>3.0 -2.0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.25 0.25 4.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.25 0.25 4.0</size></box></geometry>
          <material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.35 0.35 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="uav_sized_static_box">
      <static>true</static>
      <pose>0.5 3.0 2.8 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.65 0.65 0.30</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 0.30</size></box></geometry>
          <material><ambient>0.5 0.2 0.2 1</ambient><diffuse>0.65 0.25 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>0</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    </physics>
  </world>
</sdf>
