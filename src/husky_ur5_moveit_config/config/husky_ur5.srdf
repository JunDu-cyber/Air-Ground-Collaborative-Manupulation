<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="husky_ur5">
    <!--GROUPS: Representation of a set of joints and links. This can be useful for specifying DOF to plan for, defining arms, end effectors, etc-->
    <!--LINKS: When a link is specified, the parent joint of that link (if it exists) is automatically included-->
    <!--JOINTS: When a joint is specified, the child link of that joint (which will always exist) is automatically included-->
    <!--CHAINS: When a chain is specified, all the links along the chain (including endpoints) are included in the group. Additionally, all the joints that are parents to included links are also included. This means that joints along the chain and the parent joint of the base link are included in the group-->
    <!--SUBGROUPS: Groups can also be formed by referencing to already defined group names-->
    <group name="ur5_arm">
        <chain base_link="ur5_base_link" tip_link="ur5_tool0"/>
    </group>
    <!-- Robotiq 2F-140: single actuated joint; all other finger joints mimic it.
         (Renamed from the legacy "hand_e_gripper", a leftover from the Hand-E era —
         the gripper has been a 2F-140 for a long time.) -->
    <group name="gripper">
        <joint name="finger_joint"/>
    </group>

    <!-- End effector. There was none before, so MoveIt had no EE registered and no
         attach/detach semantics to hang a grasp on. grasp_tcp (defined in the URDF) is
         THE grasp frame: +Z approach, +X finger-closing, origin at the jaw center-line. -->
    <end_effector name="gripper_ee" parent_link="ur5_tool0" group="gripper" parent_group="ur5_arm"/>

    <!-- ===== Named states =====
         There were ZERO group_states before; every pose was a hardcoded float array in
         Python. finger_joint: 0 = fully open (136 mm gap), 0.695 = closed (8 mm).
         The gap is NOT linear in the joint angle (2F-140 four-bar linkage) — measured:
             q=0.000 -> 136.0 mm      q=0.350 -> 75.9 mm
             q=0.536 ->  40.0 mm      q=0.695 ->  8.3 mm
         "closed" = 0.556 -> 36 mm, i.e. a 4 mm squeeze on the 40 mm landmine detonator. -->
    <group_state name="open" group="gripper">
        <joint name="finger_joint" value="0.0"/>
    </group_state>
    <!-- PAD GAP vs finger_joint. Computed by FK straight from this robot's URDF (mimic
         multipliers read from the URDF, not guessed), and independently confirmed against a
         teammate's measured table -- all six shared rows agree to three decimals:

             q      0.000   0.400   0.450   0.480   0.490   0.495   0.500   0.513   0.580
             gap   128.5    58.9    49.3    43.46   41.50   40.53   39.55   37.00   23.76  mm

         READ THAT LAST COLUMN. The detonator is a 40 mm block, so the old "closed" state of
         0.58 was commanding the pads 16.2 mm INSIDE it -- 8 mm of interpenetration per pad.

         That is not a grip. This gripper CANNOT grip: every mimic joint is driven by
         MimicJointPlugin's SetPosition() (a kinematic teleport) and right_outer_knuckle_joint
         is itself a mimic, so the whole right finger is kinematic -- forced to its commanded
         angle regardless of contact, exerting zero force. It never stalls; it PENETRATES.
         Measured: finger_joint reached its commanded 0.580 with the block between the pads.
         The penetration comes back as solver impulses that eject the mine and throw the 46 kg
         Husky. THAT is "the roll" -- a contact-solver artefact, not a centre-of-mass effect.

         (An earlier version of this comment claimed "measured: q=0.537 -> 40 mm" and reasoned
         from it that 0.58 over-closed by a harmless ~7 mm. Both numbers were invented. 40 mm
         is at q~0.495, and 0.58 over-closes by 16 mm. Every conclusion drawn from that curve
         was wrong.)

         So nothing plans to "closed" any more. grasp_task.py closes the jaws in RUNGS and
         STOPS ON CONTACT (gazebo_grasp_fix's attach event), which is the only way to reach a
         40 mm block without commanding a gap narrower than it. This state survives only so the
         named pose stays truthful: 0.500 is the ladder's last rung, a 39.55 mm gap, i.e. the
         0.45 mm of squeeze the ladder will settle at if it runs to the end.

         There is deliberately NO "pregrasp" state. It used to hold the jaws at 0.45 (49.3 mm)
         during the descent, to shorten the final close. But a 40 mm square yawed by theta
         presents 40*(cos+sin) mm -- 56.6 mm at 45 deg -- so a pre-closed descent RAMS a yawed
         block on the way down (measured: the mine jumped and the base rose 3 cm before the
         jaws had closed at all). The approach now descends FULLY OPEN at 128.5 mm, which
         clears any yaw. -->
    <group_state name="closed" group="gripper">
        <joint name="finger_joint" value="0.500"/>
    </group_state>

    <!-- Arm poses.
         stow: the drive configuration the robot SPAWNS in (spawn_outdoor_city.launch -J).
               Flat on the top plate, low CoG — it matters on the slopes this mission drives.
         ready: the unstow waypoint.

         *** shoulder_lift = -1.60 + 2*pi = 4.683, NOT -1.60. ***
         These are the same physical pose, but stow sits at shoulder_lift = +3.271 (the
         spawner's -3.0, wrapped), so a target of -1.60 makes the planner rotate 279 deg
         THE LONG WAY — sweeping ur5_upper_arm_link and ur5_forearm_link straight through
         the Husky chassis. RRTConnect explores >17k states and fails. Via +4.683 the same
         pose is a 1.4 rad lift up and over, and a straight joint-space line is collision
         free at every waypoint. Do not "simplify" this back to -1.60. -->
    <group_state name="stow" group="ur5_arm">
        <joint name="ur5_shoulder_pan_joint"  value="0.0"/>
        <joint name="ur5_shoulder_lift_joint" value="3.271"/>
        <joint name="ur5_elbow_joint"         value="2.587"/>
        <joint name="ur5_wrist_1_joint"       value="0.557"/>
        <joint name="ur5_wrist_2_joint"       value="1.557"/>
        <joint name="ur5_wrist_3_joint"       value="0.0"/>
    </group_state>
    <!-- "carry": hold a grasped mine while the UGV DRIVES to the drop-off.
         NOT "stow", and that distinction is the point. Stow folds the arm back OVER THE CHASSIS,
         which is exactly where a 136 mm disc welded to the gripper has the robot's own top plate
         and the arm's own links to hit. Restowing with a mine held is asking for it.

         And NOT "ready" either: ready puts the TCP 0.641 m out in front (FK), which cantilevers
         the payload and the arm's mass forward on a robot whose CoG is already high enough to
         tip on the slopes this mission drives. Merely REACHING that far is what levers the base
         off its spot when it is not braked (measured: 0.030 m of displacement, 26 mm of lift,
         before touching anything).

         So carry pulls the payload IN and holds it UP (FK from the URDF):

             pose     tcp (base_link)          reach    mine bottom above ground
             stow     0.362, 0.113, 0.423      0.379    0.45 m   (over the chassis: no)
             ready    0.632, 0.109, 0.655      0.641    0.68 m   (cantilevered: no)
             carry    0.261, 0.109, 0.368      0.283    0.41 m   (in close, and clear)

         0.283 m of reach is the smallest lever arm we can hold this thing at, and 0.41 m of
         ground clearance survives the terrain. VERIFY IT IN RVIZ WITH THE MINE ATTACHED before
         trusting it: MoveIt checks the attached object against the robot, so if the disc fouls
         the forearm here the plan to carry will simply fail, which is the loud failure we want
         rather than a mine dragged through the chassis. -->
    <group_state name="carry" group="ur5_arm">
        <joint name="ur5_shoulder_pan_joint"  value="0.0"/>
        <joint name="ur5_shoulder_lift_joint" value="4.10"/>
        <joint name="ur5_elbow_joint"         value="2.30"/>
        <joint name="ur5_wrist_1_joint"       value="-1.10"/>
        <joint name="ur5_wrist_2_joint"       value="-1.57"/>
        <joint name="ur5_wrist_3_joint"       value="0.0"/>
    </group_state>
    <group_state name="ready" group="ur5_arm">
        <joint name="ur5_shoulder_pan_joint"  value="0.0"/>
        <joint name="ur5_shoulder_lift_joint" value="4.683"/>
        <joint name="ur5_elbow_joint"         value="1.20"/>
        <joint name="ur5_wrist_1_joint"       value="-1.20"/>
        <joint name="ur5_wrist_2_joint"       value="-1.57"/>
        <joint name="ur5_wrist_3_joint"       value="0.0"/>
    </group_state>
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_laser" link2="base_link" reason="Default"/>
    <disable_collisions link1="base_laser" link2="front_left_wheel_link" reason="Never"/>
    <disable_collisions link1="base_laser" link2="front_right_wheel_link" reason="Never"/>
    <disable_collisions link1="base_laser" link2="rear_left_wheel_link" reason="Never"/>
    <disable_collisions link1="base_laser" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="base_laser" link2="top_plate_link" reason="Adjacent"/>
    <disable_collisions link1="base_laser" link2="ur5_base_link_inertia" reason="Never"/>
    <disable_collisions link1="base_laser" link2="ur5_shoulder_link" reason="Never"/>
    <disable_collisions link1="base_link" link2="front_left_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_right_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rear_left_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rear_right_wheel_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="top_plate_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="ur5_base_link_inertia" reason="Never"/>
    <disable_collisions link1="base_link" link2="ur5_shoulder_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="front_right_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="rear_left_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="ur5_base_link_inertia" reason="Never"/>
    <disable_collisions link1="front_left_wheel_link" link2="ur5_shoulder_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="rear_left_wheel_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="ur5_base_link_inertia" reason="Never"/>
    <disable_collisions link1="front_right_wheel_link" link2="ur5_shoulder_link" reason="Never"/>
    <!-- ===== Robotiq 2F-140 gripper collision matrix ===== -->
    <!-- Gripper base to wrist/camera mount -->
    <disable_collisions link1="robotiq_arg2f_base_link" link2="ur5_wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="robotiq_arg2f_base_link" link2="ur5_wrist_2_link" reason="Never"/>
    <disable_collisions link1="robotiq_arg2f_base_link" link2="ur5_wrist_1_link" reason="Never"/>
    <disable_collisions link1="robotiq_arg2f_base_link" link2="realsense_camera_link" reason="Never"/>
    <!-- Left finger 4-bar linkage -->
    <disable_collisions link1="robotiq_arg2f_base_link" link2="left_outer_knuckle" reason="Adjacent"/>
    <disable_collisions link1="robotiq_arg2f_base_link" link2="left_inner_knuckle" reason="Adjacent"/>
    <disable_collisions link1="left_outer_knuckle" link2="left_outer_finger" reason="Adjacent"/>
    <disable_collisions link1="left_outer_knuckle" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="left_inner_finger" reason="Never"/>
    <disable_collisions link1="left_outer_finger" link2="left_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_outer_finger" link2="left_inner_finger" reason="Adjacent"/>
    <disable_collisions link1="left_outer_finger" link2="left_inner_finger_pad" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="left_inner_finger" reason="Adjacent"/>
    <disable_collisions link1="left_inner_knuckle" link2="left_inner_finger_pad" reason="Never"/>
    <disable_collisions link1="left_inner_finger" link2="left_inner_finger_pad" reason="Adjacent"/>
    <!-- Right finger 4-bar linkage -->
    <disable_collisions link1="robotiq_arg2f_base_link" link2="right_outer_knuckle" reason="Adjacent"/>
    <disable_collisions link1="robotiq_arg2f_base_link" link2="right_inner_knuckle" reason="Adjacent"/>
    <disable_collisions link1="right_outer_knuckle" link2="right_outer_finger" reason="Adjacent"/>
    <disable_collisions link1="right_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="right_outer_knuckle" link2="right_inner_finger" reason="Never"/>
    <disable_collisions link1="right_outer_finger" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="right_outer_finger" link2="right_inner_finger" reason="Adjacent"/>
    <disable_collisions link1="right_outer_finger" link2="right_inner_finger_pad" reason="Never"/>
    <disable_collisions link1="right_inner_knuckle" link2="right_inner_finger" reason="Adjacent"/>
    <disable_collisions link1="right_inner_knuckle" link2="right_inner_finger_pad" reason="Never"/>
    <disable_collisions link1="right_inner_finger" link2="right_inner_finger_pad" reason="Adjacent"/>
    <!-- Left vs right knuckles (both anchored at base, never touch when open) -->
    <disable_collisions link1="left_outer_knuckle" link2="right_outer_knuckle" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="right_inner_knuckle" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="right_outer_knuckle" reason="Never"/>
    <!-- Knuckles near the wrist/camera mount -->
    <disable_collisions link1="left_outer_knuckle" link2="ur5_wrist_3_link" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="ur5_wrist_3_link" reason="Never"/>
    <disable_collisions link1="right_outer_knuckle" link2="ur5_wrist_3_link" reason="Never"/>
    <disable_collisions link1="right_inner_knuckle" link2="ur5_wrist_3_link" reason="Never"/>
    <disable_collisions link1="left_outer_knuckle" link2="realsense_camera_link" reason="Never"/>
    <disable_collisions link1="left_inner_knuckle" link2="realsense_camera_link" reason="Never"/>
    <disable_collisions link1="right_outer_knuckle" link2="realsense_camera_link" reason="Never"/>
    <disable_collisions link1="right_inner_knuckle" link2="realsense_camera_link" reason="Never"/>
    <disable_collisions link1="realsense_camera_link" link2="ur5_wrist_1_link" reason="Never"/>
    <disable_collisions link1="realsense_camera_link" link2="ur5_wrist_2_link" reason="Never"/>
    <disable_collisions link1="realsense_camera_link" link2="ur5_wrist_3_link" reason="Adjacent"/>
    <disable_collisions link1="rear_left_wheel_link" link2="rear_right_wheel_link" reason="Never"/>
    <disable_collisions link1="rear_left_wheel_link" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="rear_left_wheel_link" link2="ur5_base_link_inertia" reason="Never"/>
    <disable_collisions link1="rear_left_wheel_link" link2="ur5_shoulder_link" reason="Never"/>
    <disable_collisions link1="rear_right_wheel_link" link2="top_plate_link" reason="Never"/>
    <disable_collisions link1="rear_right_wheel_link" link2="ur5_base_link_inertia" reason="Never"/>
    <disable_collisions link1="rear_right_wheel_link" link2="ur5_shoulder_link" reason="Never"/>
    <disable_collisions link1="top_plate_link" link2="ur5_base_link_inertia" reason="Adjacent"/>
    <disable_collisions link1="top_plate_link" link2="ur5_shoulder_link" reason="Never"/>
    <disable_collisions link1="ur5_base_link_inertia" link2="ur5_shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="ur5_forearm_link" link2="ur5_upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="ur5_forearm_link" link2="ur5_wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="ur5_shoulder_link" link2="ur5_upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="ur5_wrist_1_link" link2="ur5_wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="ur5_wrist_1_link" link2="ur5_wrist_3_link" reason="Never"/>
    <disable_collisions link1="ur5_wrist_2_link" link2="ur5_wrist_3_link" reason="Adjacent"/>
</robot>
