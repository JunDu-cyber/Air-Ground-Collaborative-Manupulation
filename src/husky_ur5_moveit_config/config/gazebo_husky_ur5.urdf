    <dynamics damping="0" friction="0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame: base_link to UR 'Base' Coordinates transform -->
  <link name="ur5_base"/>
  <joint name="ur5_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians: as base_link is REP-103
           aligned (ie: has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="ur5_base_link"/>
    <child link="ur5_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
  <link name="ur5_flange"/>
  <joint name="ur5_wrist_3-flange" type="fixed">
    <parent link="ur5_wrist_3_link"/>
    <child link="ur5_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
  <link name="ur5_tool0"/>
  <joint name="ur5_flange-tool0" type="fixed">
    <!-- default toolframe: X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="ur5_flange"/>
    <child link="ur5_tool0"/>
  </joint>
  <joint name="husky_to_ur5_joint" type="fixed">
    <parent link="top_plate_link"/>
    <child link="ur5_base_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.1 0.0 0.0"/>
  </joint>
  <!-- Virtual ballast: simulates the Husky's rear battery bank.
       The stock inertial_link iyy (1.74 kg⋅m²) is less than half the
       theoretical value for the chassis dimensions, leaving the base on the
       edge of tipping when the arm is extended.  30 kg placed 0.15 m behind
       and 0.08 m below base_link shifts the CoM rearward and raises iyy
       enough to keep the robot stable through the full grasp motion. -->
  <link name="base_ballast">
    <inertial>
      <mass value="30.0"/>
      <origin rpy="0 0 0" xyz="-0.15 0.0 -0.08"/>
      <inertia ixx="1.5" ixy="0" ixz="0" iyy="3.0" iyz="0" izz="3.0"/>
    </inertial>
  </link>
  <joint name="base_ballast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_ballast"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <!-- Gripper -->
  <joint name="robotiq_140_base_joint" type="fixed">
    <parent link="ur5_tool0"/>
    <child link="robotiq_140_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
