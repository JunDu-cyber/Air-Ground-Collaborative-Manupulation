<launch>
  <!-- By default we do not overwrite the URDF. Change the following to true to change the default behavior -->
  <arg name="load_robot_description" default="false"/>

  <!-- The name of the parameter under which the URDF is loaded -->
  <arg name="robot_description" default="robot_description"/>
  <arg name="ur5_joint_damping" default="1.5"/>
  <arg name="ur5_shoulder_lift_damping" default="20.0"/>

  <!-- Load universal robot description format (URDF) -->
  <param if="$(arg load_robot_description)" name="$(arg robot_description)" command="$(find mobile_manipulator)/scripts/generate_husky_ur5_urdf.py --xacro '$(find mobile_manipulator)/urdf/husky_ur5.urdf.xacro' --arm-joint-damping $(arg ur5_joint_damping) --shoulder-lift-joint-damping $(arg ur5_shoulder_lift_damping)"/>

  <!-- The semantic description that corresponds to the URDF -->
  <param name="$(arg robot_description)_semantic" textfile="$(find husky_ur5_moveit_config)/config/husky_ur5.srdf" />

  <!-- Load updated joint limits (override information from URDF) -->
  <group ns="$(arg robot_description)_planning">
    <rosparam command="load" file="$(find husky_ur5_moveit_config)/config/joint_limits.yaml"/>
    <rosparam command="load" file="$(find husky_ur5_moveit_config)/config/cartesian_limits.yaml"/>
  </group>

  <!-- Load default settings for kinematics; these settings are overridden by settings in a node's namespace -->
  <group ns="$(arg robot_description)_kinematics">
    <rosparam command="load" file="$(find husky_ur5_moveit_config)/config/kinematics.yaml"/>

  </group>

</launch>
