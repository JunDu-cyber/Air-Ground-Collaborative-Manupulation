<launch>
  <arg name="raw_lidar_topic" default="/uav0/velodyne_points_raw"/>
  <arg name="cloud_topic" default="/uav0/velodyne_points"/>
  <arg name="lidar_frame" default="uav0/velodyne_link"/>
  <arg name="imu_topic" default="/mavros/imu/data"/>
  <arg name="odom_topic" default="/mavros/local_position/odom"/>
  <arg name="start_lidar_relay" default="true"/>
  <arg name="frame_id" default="map"/>
  <arg name="resolution" default="0.07"/>
  <arg name="min_range" default="0.35"/>
  <arg name="max_range" default="12.0"/>
  <arg name="sensor_max_range" default="18.0"/>
  <arg name="pointcloud_min_z" default="-0.05"/>
  <arg name="pointcloud_max_z" default="1.50"/>
  <arg name="occupancy_min_z" default="0.05"/>
  <arg name="occupancy_max_z" default="1.20"/>
  <arg name="lidar_max_range" default="$(arg max_range)"/>
  <arg name="lidar_voxel_size" default="0.06"/>
  <arg name="filter_speckles" default="false"/>
  <arg name="filter_ground" default="false"/>
  <arg name="ground_filter_distance" default="0.015"/>
  <arg name="ground_filter_angle" default="0.15"/>
  <arg name="ground_filter_plane_distance" default="0.035"/>
  <arg name="sensor_model_hit" default="0.80"/>
  <arg name="sensor_model_miss" default="0.48"/>
  <arg name="sensor_model_max" default="0.97"/>
  <arg name="local_min_z" default="-999.0"/>
  <arg name="local_max_z" default="999.0"/>
  <arg name="max_angular_velocity" default="0.60"/>
  <arg name="max_imu_age" default="0.25"/>
  <arg name="max_linear_velocity" default="2.50"/>
  <arg name="max_odom_angular_velocity" default="0.60"/>
  <arg name="max_odom_age" default="0.25"/>
  <arg name="ground_filter_enabled" default="true"/>
  <arg name="ground_z" default="0.0"/>
  <arg name="ground_keep_above" default="0.35"/>
  <arg name="ground_column_filter_enabled" default="true"/>
  <arg name="ground_column_size" default="0.08"/>
  <arg name="ground_column_min_height" default="0.20"/>
  <arg name="ground_column_support_radius" default="0"/>
  <arg name="self_filter_enabled" default="true"/>
  <arg name="self_filter_body_radius" default="0.28"/>
  <arg name="self_filter_body_z_min" default="-0.16"/>
  <arg name="self_filter_body_z_max" default="0.16"/>
  <arg name="self_filter_rotor_radius" default="0.17"/>
  <arg name="self_filter_rotor_z_min" default="-0.14"/>
  <arg name="self_filter_rotor_z_max" default="0.06"/>
  <arg name="publish_in_world_frame" default="false"/>
  <arg name="world_frame" default="$(arg frame_id)"/>
  <arg name="output_frame" default="$(arg lidar_frame)"/>
  <arg name="stamp_with_odom" default="true"/>
  <arg name="lidar_mount_x" default="0.0"/>
  <arg name="lidar_mount_y" default="0.0"/>
  <arg name="lidar_mount_z" default="0.06"/>
  <arg name="output_dir" default="$(env HOME)/octomap_maps"/>
  <arg name="save_on_shutdown" default="false"/>
  <arg name="autosave_interval" default="45.0"/>
  <arg name="autosave_updates_latest" default="false"/>

  <include if="$(arg start_lidar_relay)" file="$(find forest_avoidance_utils)/launch/forest_lidar_relay.launch">
    <arg name="raw_lidar_topic" value="$(arg raw_lidar_topic)"/>
    <arg name="cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="lidar_frame" value="$(arg lidar_frame)"/>
    <arg name="output_frame" value="$(arg output_frame)"/>
    <arg name="publish_in_world_frame" value="$(arg publish_in_world_frame)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="stamp_with_odom" value="$(arg stamp_with_odom)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="min_range" value="$(arg min_range)"/>
    <arg name="max_range" value="$(arg lidar_max_range)"/>
    <arg name="sensor_max_range" value="$(arg sensor_max_range)"/>
    <arg name="voxel_size" value="$(arg lidar_voxel_size)"/>
    <arg name="max_angular_velocity" value="$(arg max_angular_velocity)"/>
    <arg name="max_imu_age" value="$(arg max_imu_age)"/>
    <arg name="max_linear_velocity" value="$(arg max_linear_velocity)"/>
    <arg name="max_odom_angular_velocity" value="$(arg max_odom_angular_velocity)"/>
    <arg name="max_odom_age" value="$(arg max_odom_age)"/>
    <arg name="ground_filter_enabled" value="$(arg ground_filter_enabled)"/>
    <arg name="ground_z" value="$(arg ground_z)"/>
    <arg name="ground_keep_above" value="$(arg ground_keep_above)"/>
    <arg name="ground_column_filter_enabled" value="$(arg ground_column_filter_enabled)"/>
    <arg name="ground_column_size" value="$(arg ground_column_size)"/>
    <arg name="ground_column_min_height" value="$(arg ground_column_min_height)"/>
    <arg name="ground_column_support_radius" value="$(arg ground_column_support_radius)"/>
    <arg name="self_filter_enabled" value="$(arg self_filter_enabled)"/>
    <arg name="self_filter_body_radius" value="$(arg self_filter_body_radius)"/>
    <arg name="self_filter_body_z_min" value="$(arg self_filter_body_z_min)"/>
    <arg name="self_filter_body_z_max" value="$(arg self_filter_body_z_max)"/>
    <arg name="self_filter_rotor_radius" value="$(arg self_filter_rotor_radius)"/>
    <arg name="self_filter_rotor_z_min" value="$(arg self_filter_rotor_z_min)"/>
    <arg name="self_filter_rotor_z_max" value="$(arg self_filter_rotor_z_max)"/>
    <arg name="lidar_mount_x" value="$(arg lidar_mount_x)"/>
    <arg name="lidar_mount_y" value="$(arg lidar_mount_y)"/>
    <arg name="lidar_mount_z" value="$(arg lidar_mount_z)"/>
  </include>

  <node pkg="forest_avoidance_utils" type="octomap_manager.py"
        name="octomap_manager" output="screen">
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
    <param name="frame_id" value="$(arg frame_id)"/>
    <param name="resolution" value="$(arg resolution)"/>
    <param name="sensor_model_min_range" value="$(arg min_range)"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="pointcloud_min_z" value="$(arg pointcloud_min_z)"/>
    <param name="pointcloud_max_z" value="$(arg pointcloud_max_z)"/>
    <param name="occupancy_min_z" value="$(arg occupancy_min_z)"/>
    <param name="occupancy_max_z" value="$(arg occupancy_max_z)"/>
    <param name="filter_speckles" value="$(arg filter_speckles)"/>
    <param name="filter_ground" value="$(arg filter_ground)"/>
    <param name="ground_filter_distance" value="$(arg ground_filter_distance)"/>
    <param name="ground_filter_angle" value="$(arg ground_filter_angle)"/>
    <param name="ground_filter_plane_distance" value="$(arg ground_filter_plane_distance)"/>
    <param name="sensor_model_hit" value="$(arg sensor_model_hit)"/>
    <param name="sensor_model_miss" value="$(arg sensor_model_miss)"/>
    <param name="sensor_model_max" value="$(arg sensor_model_max)"/>
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="filename_prefix" value="forest_octomap"/>
    <param name="autosave_interval" value="$(arg autosave_interval)"/>
    <param name="cleanup_old_autosaves" value="true"/>
    <param name="save_on_shutdown" value="$(arg save_on_shutdown)"/>
    <param name="autosave_updates_latest" value="$(arg autosave_updates_latest)"/>
  </node>

  <!-- 2D map saver: saves projected_map as standard yaml+pgm for ground robot -->
  <node pkg="forest_avoidance_utils" type="map2d_saver.py"
        name="map2d_saver" output="screen">
    <param name="output_dir" value="$(arg output_dir)"/>
    <param name="map_topic" value="/octomap_server/projected_map"/>
    <param name="filename" value="forest_2d_map"/>
    <param name="save_interval" value="$(arg autosave_interval)"/>
    <param name="save_on_shutdown" value="true"/>
  </node>
</launch>
